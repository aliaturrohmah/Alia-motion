      const hasWebCodecs = typeof VideoEncoder !== 'undefined' && typeof AudioEncoder !== 'undefined' && typeof Mp4Muxer !== 'undefined';
      codecBadge.textContent = hasWebCodecs
        ? `Codec: H.264 + AAC MP4 • ${width}x${height} @ ${fps}FPS`
        : `Codec: MediaRecorder MP4 Fallback • ${width}x${height}`;

      const updateModalProgress = (pct, sceneNum, detailText) => {

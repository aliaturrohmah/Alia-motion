      updateModalProgress(0, 1, 'Memulai proses encoding MP4...');
      modal.classList.remove('hidden');
      modal.classList.add('flex');

      let mp4Blob = null;

      try {
        if (hasWebCodecs) {
          mp4Blob = await exportTrueMp4WebCodecs(width, height, fps, totalDurationSec, updateModalProgress);
        } else {
          mp4Blob = await exportMp4MediaRecorderFallback(width, height, fps, totalDurationSec, updateModalProgress);
        }
      } catch (err) {
        console.warn('WebCodecs primary path fallback triggered:', err);
        codecBadge.textContent = `Codec: MediaRecorder MP4 Fallback • ${width}x${height}`;
        mp4Blob = await exportMp4MediaRecorderFallback(width, height, fps, totalDurationSec, updateModalProgress);
      }

      modal.classList.add('hidden');
      modal.classList.remove('flex');
      state.exportSettings.isExporting = false;

      if (state.exportSettings.cancelRequested || !mp4Blob) {
        showToast('Export video .MP4 dibatalkan.', 'info');
        return;
      }

      updateModalProgress(100, state.scenes.length, 'Selesai!');

      const url = URL.createObjectURL(mp4Blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'AliaMotion_Studio_HD.mp4';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(() => URL.revokeObjectURL(url), 2000);

      showToast('🎉 Video AliaMotion_Studio_HD.mp4 berhasil diunduh!', 'success');
    }


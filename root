    function renderTimeline() {
      const totalDur = Math.max(1, getTotalDuration());
      const ruler = document.getElementById('timelineRuler');
      const videoTrack = document.getElementById('timelineVideoTrack');
      const voiceTrack = document.getElementById('timelineVoiceTrack');
      const subTrack = document.getElementById('timelineSubtitleTrack');

      if (!ruler || !videoTrack || !voiceTrack || !subTrack) return;

      ruler.innerHTML = '';
      const step = totalDur <= 15 ? 2 : 5;
      for (let sec = 0; sec <= Math.floor(totalDur); sec += step) {
        const pct = (sec / totalDur) * 100;
        const mark = document.createElement('span');
        mark.style.left = `${pct}%`;
        mark.className = 'absolute -translate-x-1/2';
        mark.textContent = `00:${String(sec).padStart(2, '0')}`;
        ruler.appendChild(mark);
      }

      videoTrack.innerHTML = '';
      voiceTrack.innerHTML = '';

      const blockColors = [
        'from-pastel-lavender to-pastel-blush border-purple-400 text-purple-950',
        'from-pastel-sky to-pastel-lavender border-sky-400 text-sky-950',
        'from-pastel-blush to-amber-100 border-pink-400 text-rose-950',
        'from-pastel-mint to-pastel-sky border-emerald-400 text-emerald-950'
      ];

      state.scenes.forEach((sc, idx) => {
        const widthPct = (Number(sc.duration) / totalDur) * 100;
        const colorCls = blockColors[idx % blockColors.length];
        const isSelected = idx === state.selectedSceneIndex;

        const vBlock = document.createElement('div');
        vBlock.style.width = `${widthPct}%`;
        vBlock.className = `h-10 rounded-[14px] bg-gradient-to-r ${colorCls} border px-2 flex items-center justify-between gap-1 overflow-hidden ${
          isSelected ? 'ring-2 ring-purple-600' : ''
        }`;
        vBlock.innerHTML = `
          <span class="text-[11px] font-bold truncate">${escapeHtml(sc.title)}</span>
          <span class="text-[10px] font-mono opacity-80 shrink-0">${Number(sc.duration).toFixed(1)}d</span>
        `;
        videoTrack.appendChild(vBlock);

        const wBlock = document.createElement('div');
        wBlock.style.width = `${widthPct}%`;
        wBlock.className = 'h-8 rounded-[14px] bg-pastel-blushLight border border-pastel-blush px-2 flex items-center justify-around gap-0.5 overflow-hidden';
        const barCount = Math.max(8, Math.round(widthPct * 0.42));
        const realPeaks = sc.audioBuffer ? computeWaveformPeaks(sc.audioBuffer, barCount) : null;
        let barsHtml = '';
        for (let b = 0; b < barCount; b++) {
          const amp = realPeaks
            ? realPeaks[b]
            : (sc.narration ? (25 + Math.abs(Math.sin(b * 1.3 + idx)) * 65) : 12);
          barsHtml += `<span class="w-0.5 ${sc.audioBuffer ? 'bg-[#B892FF]' : 'bg-[#FF8FB1]'} rounded-full" style="height:${Math.round(amp)}%"></span>`;
        }
        wBlock.innerHTML = barsHtml;
        voiceTrack.appendChild(wBlock);
      });

      subTrack.innerHTML = '';
      state.subtitle.segments.forEach((seg) => {
        const leftPct = (seg.start / totalDur) * 100;
        const widthPct = Math.max(2, ((seg.end - seg.start) / totalDur) * 100);
        const pill = document.createElement('div');
        pill.style.left = `${leftPct}%`;
        pill.style.width = `${widthPct}%`;
        pill.title = seg.text;
        pill.className = 'absolute top-1 bottom-1 rounded-xl bg-pastel-mint border border-emerald-300 px-1.5 flex items-center text-[10px] font-bold text-emerald-950 truncate';
        pill.textContent = seg.text;
        subTrack.appendChild(pill);
      });
    }

    function escapeHtml(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }


    function playHumanBreathSound(volume = 0.25) {
      bgmEngine.unlock();
      if (!bgmEngine.ctx) return;
      const ctx = bgmEngine.ctx;
      const dur = 0.26;
      const sampleRate = ctx.sampleRate;
      const length = Math.floor(sampleRate * dur);
      const buffer = ctx.createBuffer(1, length, sampleRate);
      const data = buffer.getChannelData(0);

      let b0 = 0, b1 = 0, b2 = 0;
      for (let i = 0; i < length; i++) {
        const white = Math.random() * 2 - 1;
        b0 = 0.99765 * b0 + white * 0.0990460;
        b1 = 0.96300 * b1 + white * 0.2965164;
        b2 = 0.57000 * b2 + white * 1.0526913;
        const pink = (b0 + b1 + b2 + white * 0.1848) * 0.06;
        const env = Math.sin((i / length) * Math.PI);
        data[i] = pink * env;
      }

      const src = ctx.createBufferSource();
      src.buffer = buffer;

      const bandpass = ctx.createBiquadFilter();
      bandpass.type = 'bandpass';
      bandpass.frequency.value = 1150;
      bandpass.Q.value = 1.2;

      const gain = ctx.createGain();
      gain.gain.value = Math.min(0.35, volume * 0.22);

      src.connect(bandpass);
      bandpass.connect(gain);
      gain.connect(ctx.destination);
      src.start();
    }

    function discoverAndRankVoices() {
      if (!('speechSynthesis' in window)) return;
      const voices = window.speechSynthesis.getVoices() || [];
      if (!voices.length) return;

      const scoreVoice = (v) => {
        const name = (v.name || '').toLowerCase();
        const lang = (v.lang || '').toLowerCase();
        let score = 0;
        if (lang.startsWith('id')) score += 100;
        else if (lang.startsWith('ms')) score += 45;
        else if (lang.startsWith('en')) score += 15;

        if (name.includes('natural')) score += 60;
        if (name.includes('online')) score += 35;
        if (name.includes('google')) score += 30;
        if (name.includes('gadis') || name.includes('ardi')) score += 40;
        if (name.includes('damayanti')) score += 25;
        if (name.includes('neural') || name.includes('wavenet')) score += 35;
        return score;
      };

      const ranked = voices
        .map((v) => ({ voice: v, score: scoreVoice(v) }))
        .sort((a, b) => b.score - a.score);

      state.voice.rankedVoices = ranked;

      const selectEl = document.getElementById('systemVoiceSelect');
      const badgeEl = document.getElementById('naturalVoiceQualityBadge');
      if (selectEl) {
        const prevVal = state.voice.selectedVoiceURI || 'auto';
        selectEl.innerHTML = '<option value="auto">🌟 Otomatis Terbaik (Gadis / Ardi / Google ID)</option>';
        ranked.slice(0, 25).forEach(({ voice, score }) => {
          const opt = document.createElement('option');
          opt.value = voice.voiceURI;
          const tag = score >= 130 ? '★ Neural ID' : score >= 100 ? 'ID' : voice.lang;
          opt.textContent = `${voice.name} (${tag})`;
          selectEl.appendChild(opt);
        });
        if ([...selectEl.options].some(o => o.value === prevVal)) {
          selectEl.value = prevVal;
        }
      }

      if (badgeEl) {
        const bestId = ranked.find(r => (r.voice.lang || '').toLowerCase().startsWith('id'));
        if (bestId && bestId.score >= 130) {
          badgeEl.textContent = `✨ Neural ID: ${bestId.voice.name.slice(0, 24)}`;
        } else if (bestId) {
          badgeEl.textContent = `🎙️ Suara ID: ${bestId.voice.name.slice(0, 24)}`;
        } else {
          badgeEl.textContent = `🌐 ${ranked.length} Suara Browser Siap`;
        }
      }
    }

    if ('speechSynthesis' in window) {
      discoverAndRankVoices();
      window.speechSynthesis.onvoiceschanged = discoverAndRankVoices;
      setTimeout(discoverAndRankVoices, 500);
      setTimeout(discoverAndRankVoices, 1600);
    }

    function pickBestVoiceForPersona() {
      if (!state.voice.rankedVoices.length) discoverAndRankVoices();
      const ranked = state.voice.rankedVoices;
      if (!ranked.length) return null;

      if (state.voice.selectedVoiceURI !== 'auto') {
        const found = ranked.find(r => r.voice.voiceURI === state.voice.selectedVoiceURI);
        if (found) return found.voice;
      }

      const personaCfg = VOICE_PERSONAS[state.voice.persona] || VOICE_PERSONAS.podcast;
      const idVoices = ranked.filter(r => (r.voice.lang || '').toLowerCase().startsWith('id'));
      const pool = idVoices.length > 0 ? idVoices : ranked;

      if (!personaCfg.preferFemale) {
        const maleVoice = pool.find(r => /ardi|male|laki|pria|andika/i.test(r.voice.name));
        if (maleVoice) return maleVoice.voice;
      } else {
        const femaleVoice = pool.find(r => /gadis|damayanti|female|wanita|perempuan|google bahasa/i.test(r.voice.name));
        if (femaleVoice) return femaleVoice.voice;
      }

      return pool[0].voice;
    }


    function handleSceneAction(action, idx) {
      if (action === 'up' && idx > 0) {
        [state.scenes[idx - 1], state.scenes[idx]] = [state.scenes[idx], state.scenes[idx - 1]];
        state.selectedSceneIndex = idx - 1;
      } else if (action === 'down' && idx < state.scenes.length - 1) {
        [state.scenes[idx + 1], state.scenes[idx]] = [state.scenes[idx], state.scenes[idx + 1]];
        state.selectedSceneIndex = idx + 1;
      } else if (action === 'dup') {
        const orig = state.scenes[idx];
        const copy = {
          ...JSON.parse(JSON.stringify(orig)),
          id: 'scene-' + Date.now(),
          title: `${orig.title} (Salinan)`,
          audioBuffer: orig.audioBuffer || null,
          audioSourceType: orig.audioSourceType || 'browser'
        };
        state.scenes.splice(idx + 1, 0, copy);
        state.selectedSceneIndex = idx + 1;
        showToast('Adegan berhasil diduplikat ✨', 'info');
      } else if (action === 'del') {
        if (state.scenes.length <= 1) {
          showToast('Minimal harus ada 1 adegan di storyboard.', 'info');
          return;
        }
        state.scenes.splice(idx, 1);
        state.selectedSceneIndex = Math.max(0, Math.min(state.selectedSceneIndex, state.scenes.length - 1));
        showToast('Adegan dihapus.', 'info');
      }

      state.scenes.forEach((s, i) => {
        if (/^Adegan \d+$/.test(s.title)) s.title = `Adegan ${i + 1}`;
      });

      syncEditorFieldsFromSelectedScene();
      renderSceneListUI();
      rebuildSubtitlesFromVoice();
    }


    async function speakSceneNatural(scene, forceBrowserSpeech = false) {
      if (!scene) return;
      stopNaturalSpeech();

      const sessionId = state.voice.speechSessionId;
      const phraseDisplay = document.getElementById('prosodyPhraseDisplay');

      if (!forceBrowserSpeech && scene.audioBuffer) {
        bgmEngine.setDucking(true);
        setTtsWaveAnimating(true);
        const badgeLabel = scene.audioSourceType === 'human'
          ? '🎤 Memutar Suara Asli (Studio Mastered)'
          : scene.audioSourceType === 'cloud'
            ? '✨ Memutar Neural AI Ultra-Human'
            : '🎧 Memutar Audio Neural Tertangkap';
        if (phraseDisplay) {
          phraseDisplay.textContent = `${badgeLabel}: "${stripProsodyTagsForSubtitle(scene.narration)}"`;
        }
        bgmEngine.playBuffer(scene.audioBuffer, state.voice.volume, () => {
          if (state.voice.speechSessionId === sessionId) {
            bgmEngine.setDucking(false);
            setTtsWaveAnimating(false);
          }
        });
        return;
      }

      if (!('speechSynthesis' in window)) {
        showToast('Browser tidak mendukung SpeechSynthesis, memakai simulasi waktu.', 'info');
        return;
      }

      const clauses = splitTextIntoProsodyClauses(scene.narration, state.voice.pitch, state.voice.rate);
      if (!clauses.length) return;

      const selectedVoice = pickBestVoiceForPersona();
      bgmEngine.setDucking(true);
      setTtsWaveAnimating(true);

      for (let i = 0; i < clauses.length; i++) {
        if (state.voice.speechSessionId !== sessionId) break;
        const clause = clauses[i];

        if (phraseDisplay) {
          phraseDisplay.innerHTML = `${clause.breathBefore ? '<span class="text-sky-600 font-bold mr-1">[napas]</span>' : ''}<span class="px-1.5 py-0.5 rounded-lg bg-[#B892FF] text-white font-semibold">${escapeHtml(clause.displayClause)}</span>`;
        }

        if (clause.breathBefore) {
          playHumanBreathSound(state.voice.volume);
          await new Promise(r => setTimeout(r, Math.max(240, clause.prePauseMs)));
        } else if (clause.prePauseMs > 0) {
          await new Promise(r => setTimeout(r, clause.prePauseMs));
        }

        if (state.voice.speechSessionId !== sessionId) break;

        await new Promise((resolve) => {
          try {
            const utter = new SpeechSynthesisUtterance(clause.speakableText);
            if (selectedVoice) utter.voice = selectedVoice;
            utter.lang = (selectedVoice && selectedVoice.lang) || 'id-ID';
            utter.pitch = clause.pitch;
            utter.rate = clause.rate;
            utter.volume = state.voice.volume;

            let settled = false;
            const finish = () => {
              if (!settled) {
                settled = true;
                resolve();
              }
            };

            utter.onend = finish;
            utter.onerror = finish;
            setTimeout(finish, Math.max(2500, clause.speakableText.length * 145));

            window.speechSynthesis.speak(utter);
          } catch (e) {
            resolve();
          }
        });

        if (state.voice.speechSessionId !== sessionId) break;

        if (clause.pauseMs > 0 && i < clauses.length - 1) {
          await new Promise(r => setTimeout(r, clause.pauseMs));
        }
      }

      if (state.voice.speechSessionId === sessionId) {
        bgmEngine.setDucking(false);
        setTtsWaveAnimating(false);
        if (phraseDisplay) {
          phraseDisplay.textContent = 'Selesai membacakan frasa dengan intonasi & napas alami.';
        }
      }
    }


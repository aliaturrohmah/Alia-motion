      document.querySelectorAll('.persona-card').forEach((card) => {
        card.addEventListener('click', () => {
          const pKey = card.dataset.persona;
          state.voice.persona = pKey;
          const cfg = VOICE_PERSONAS[pKey];
          if (cfg) {
            state.voice.pitch = cfg.pitch;
            state.voice.rate = cfg.rate;
            document.getElementById('voicePitchRange').value = cfg.pitch;
            document.getElementById('voicePitchVal').textContent = cfg.pitch.toFixed(2);
            document.getElementById('voiceRateRange').value = cfg.rate;
            document.getElementById('voiceRateVal').textContent = `${cfg.rate.toFixed(2)}x`;
          }
          updatePersonaCardsUI();
          rebuildSubtitlesFromVoice();
        });
      });

      document.getElementById('voicePitchRange').addEventListener('input', (e) => {
        state.voice.pitch = parseFloat(e.target.value);
        document.getElementById('voicePitchVal').textContent = state.voice.pitch.toFixed(2);
      });

      document.getElementById('voiceRateRange').addEventListener('input', (e) => {
        state.voice.rate = parseFloat(e.target.value);
        document.getElementById('voiceRateVal').textContent = `${state.voice.rate.toFixed(2)}x`;
        if (state.voice.syncNarration) {
          state.scenes.forEach(sc => {
            if (!sc.audioBuffer) {
              sc.duration = estimateSpeechDuration(sc.narration, state.voice.rate);
            }
          });
          syncEditorFieldsFromSelectedScene();
          renderSceneListUI();
          rebuildSubtitlesFromVoice();
        }
      });

      document.getElementById('voiceVolRange').addEventListener('input', (e) => {
        state.voice.volume = parseFloat(e.target.value);
        document.getElementById('voiceVolVal').textContent = `${Math.round(state.voice.volume * 100)}%`;
      });

      document.getElementById('bgmTypeSelect').addEventListener('change', (e) => {
        state.voice.bgmType = e.target.value;
        if (state.playback.isPlaying) {
          bgmEngine.stop();
          bgmEngine.start();
        }
      });

      document.getElementById('bgmVolRange').addEventListener('input', (e) => {
        state.voice.bgmVolume = parseFloat(e.target.value);
        document.getElementById('bgmVolVal').textContent = `${Math.round(state.voice.bgmVolume * 100)}%`;
        bgmEngine.setVolume(state.voice.bgmVolume);
      });

      document.getElementById('btnSynthesizeCurrentCloud').addEventListener('click', () => synthesizeCloudNeuralScenes(true));
      document.getElementById('btnSynthesizeCloudAudio').addEventListener('click', () => synthesizeCloudNeuralScenes(false));

      // Inspector Tab 2: Subtitle Styling
      document.getElementById('autoSplitSubToggle').addEventListener('change', (e) => {
        state.subtitle.autoSplitShort = e.target.checked;
        rebuildSubtitlesFromVoice();
      });

      document.getElementById('btnRegenerateSubtitles').addEventListener('click', () => {
        rebuildSubtitlesFromVoice();
        showToast('Subtitle disinkronkan ulang 💬', 'info');
      });

      document.getElementById('subStyleSelect').addEventListener('change', (e) => {
        state.subtitle.style = e.target.value;
      });

      document.getElementById('subFontSelect').addEventListener('change', (e) => {
        state.subtitle.fontFamily = e.target.value;
      });

      document.getElementById('subFontSizeRange').addEventListener('input', (e) => {
        state.subtitle.fontSize = parseInt(e.target.value, 10);
        document.getElementById('subFontSizeVal').textContent = `${state.subtitle.fontSize}px`;
      });

      document.querySelectorAll('.sub-pos-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          state.subtitle.position = btn.dataset.subpos;
          document.querySelectorAll('.sub-pos-btn').forEach((b) => {
            b.classList.remove('bg-purple-600', 'text-white', 'font-bold');
            b.classList.add('text-slate-600', 'font-semibold');
          });
          btn.classList.add('bg-purple-600', 'text-white', 'font-bold');
          btn.classList.remove('text-slate-600', 'font-semibold');
        });
      });

      document.getElementById('subTextColor').addEventListener('input', (e) => {
        state.subtitle.textColor = e.target.value;
      });

      document.getElementById('subHighlightColor').addEventListener('input', (e) => {
        state.subtitle.highlightColor = e.target.value;
      });

      document.getElementById('subBgColor').addEventListener('input', (e) => {
        state.subtitle.bgColor = e.target.value;
      });

      document.getElementById('subBgOpacityRange').addEventListener('input', (e) => {
        state.subtitle.bgOpacity = parseFloat(e.target.value);
        document.getElementById('subBgOpacityVal').textContent = `${Math.round(state.subtitle.bgOpacity * 100)}%`;
      });

      // Inspector Tab 3: Export MP4 & Secondary Exports
      document.getElementById('exportResolutionSelect').addEventListener('change', (e) => {
        state.exportSettings.resolution = e.target.value;
        updateAspectButtonsUI();
      });

      document.getElementById('exportFpsSelect').addEventListener('change', (e) => {
        state.exportSettings.fps = parseInt(e.target.value, 10);
      });

      document.getElementById('btnTabExportMp4').addEventListener('click', startTrueMp4Export);
      document.getElementById('btnExportWebm').addEventListener('click', exportWebmVideo);
      document.getElementById('btnDownloadSRT').addEventListener('click', () => exportSubtitles('srt'));
      document.getElementById('btnDownloadVTT').addEventListener('click', () => exportSubtitles('vtt'));
      document.getElementById('btnCopyFullScript').addEventListener('click', copyFullScriptToClipboard);

      document.getElementById('btnCancelMp4Export').addEventListener('click', () => {
        state.exportSettings.cancelRequested = true;
      });

      // Transport Controls
      document.getElementById('btnPlayPause').addEventListener('click', () => {
        if (state.playback.isPlaying) pausePlayback();
        else startPlayback();
      });

      document.getElementById('btnStopReset').addEventListener('click', stopAndResetPlayback);

      document.getElementById('btnPrevScene').addEventListener('click', () => {
        const info = getSceneAtTime(state.playback.currentTime);
        const targetIdx = Math.max(0, info.index - 1);
        state.selectedSceneIndex = targetIdx;
        state.playback.currentTime = getSceneTimeBounds(targetIdx).start + 0.01;
        state.playback.lastSpokenSceneId = null;
        syncEditorFieldsFromSelectedScene();
        renderSceneListUI();
        renderTimeline();
      });

      document.getElementById('btnNextScene').addEventListener('click', () => {
        const info = getSceneAtTime(state.playback.currentTime);
        const targetIdx = Math.min(state.scenes.length - 1, info.index + 1);
        state.selectedSceneIndex = targetIdx;
        state.playback.currentTime = getSceneTimeBounds(targetIdx).start + 0.01;
        state.playback.lastSpokenSceneId = null;
        syncEditorFieldsFromSelectedScene();
        renderSceneListUI();
        renderTimeline();
      });

      document.getElementById('btnToggleLoop').addEventListener('click', (e) => {
        state.playback.isLooping = !state.playback.isLooping;
        const btn = e.currentTarget;
        if (state.playback.isLooping) {
          btn.classList.add('bg-pastel-lavender', 'text-purple-950', 'border-purple-400');
          btn.classList.remove('bg-white', 'text-slate-500');
          showToast('Loop otomatis aktif 🔁', 'info');
        } else {
          btn.classList.remove('bg-pastel-lavender', 'text-purple-950', 'border-purple-400');
          btn.classList.add('bg-white', 'text-slate-500');
        }
      });

      // Timeline Scrubbing
      const timelineWrapper = document.getElementById('timelineWrapper');
      let isScrubbing = false;

      const scrubToClientX = (clientX) => {
        const rect = timelineWrapper.getBoundingClientRect();
        const trackStart = rect.left + 92;
        const trackWidth = Math.max(60, rect.width - 102);
        const ratio = Math.min(1, Math.max(0, (clientX - trackStart) / trackWidth));
        state.playback.currentTime = ratio * getTotalDuration();
        state.playback.lastSpokenSceneId = null;

        const info = getSceneAtTime(state.playback.currentTime);
        if (info.index !== state.selectedSceneIndex) {
          state.selectedSceneIndex = info.index;
          syncEditorFieldsFromSelectedScene();
          renderSceneListUI();
        }
        renderTimeline();
      };

      timelineWrapper.addEventListener('mousedown', (e) => {
        isScrubbing = true;
        scrubToClientX(e.clientX);
      });
      window.addEventListener('mousemove', (e) => {
        if (isScrubbing) scrubToClientX(e.clientX);
      });
      window.addEventListener('mouseup', () => {
        isScrubbing = false;
      });
      timelineWrapper.addEventListener('touchstart', (e) => {
        if (e.touches[0]) scrubToClientX(e.touches[0].clientX);
      }, { passive: true });
      timelineWrapper.addEventListener('touchmove', (e) => {
        if (e.touches[0]) scrubToClientX(e.touches[0].clientX);
      }, { passive: true });

      // Modal: Split Paragraph into Scenes
      const splitModal = document.getElementById('splitTextModal');
      document.getElementById('btnOpenSplitModal').addEventListener('click', () => {
        splitModal.classList.remove('hidden');
        splitModal.classList.add('flex');
      });
      const closeSplit = () => {
        splitModal.classList.add('hidden');
        splitModal.classList.remove('flex');
      };
      document.getElementById('btnCloseSplitModal').addEventListener('click', closeSplit);
      document.getElementById('btnCancelSplit').addEventListener('click', closeSplit);

      document.getElementById('btnConfirmSplit').addEventListener('click', () => {
        const raw = document.getElementById('splitParagraphInput').value.trim();
        if (!raw) {
          showToast('Silakan masukkan teks cerita terlebih dahulu.', 'info');
          return;
        }
        const sentences = raw
          .split(/(?<=[.!?])\s+|\n+/)
          .map(s => s.trim())
          .filter(Boolean);

        const motions = ['zoom-in', 'pan-right', 'floating-drift', 'parallax-sway'];
        const particlesList = ['sakura', 'fireflies', 'stars', 'bokeh'];

        state.scenes = sentences.map((sentence, i) => ({
          id: `scene-split-${Date.now()}-${i}`,
          title: `Adegan ${i + 1}`,
          prompt: sentence,
          narration: `[napas] ${sentence}`,
          duration: estimateSpeechDuration(sentence, state.voice.rate),
          cameraMotion: motions[i % motions.length],
          particles: particlesList[i % particlesList.length],
          illustrationOverride: 'auto',
          paletteSeed: 'sunset-sakura',
          audioBuffer: null,
          audioSourceType: 'browser'
        }));

        state.selectedSceneIndex = 0;
        state.playback.currentTime = 0;
        syncEditorFieldsFromSelectedScene();
        renderSceneListUI();
        rebuildSubtitlesFromVoice();
        closeSplit();
        showToast(`🪄 Berhasil memecah naskah menjadi ${state.scenes.length} adegan!`, 'success');
      });

      window.addEventListener('resize', resizePreviewCanvas);
    }

    // Boot Studio on Window Load
    window.addEventListener('load', () => {
      if (window.lucide) lucide.createIcons();
      discoverAndRankVoices();
      bindAllEvents();
      updateAspectButtonsUI();
      resizePreviewCanvas();
      syncEditorFieldsFromSelectedScene();
      renderSceneListUI();
      rebuildSubtitlesFromVoice();
      requestAnimationFrame(animationLoop);
    });
  </script>
</body>
</html>

    function getExportDimensions() {
      const is1080p = state.exportSettings.resolution === '1080p';
      const ratioCfg = PLATFORM_RATIOS[state.aspectRatio] || PLATFORM_RATIOS['16:9'];
      return is1080p ? ratioCfg.dim1080 : ratioCfg.dim720;

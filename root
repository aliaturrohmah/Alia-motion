    // -------------------------------------------------------------------------
    // 6. TIMING, DURATION & SPEECH-ENVELOPE SUBTITLE SYNCHRONIZATION ENGINE
    // -------------------------------------------------------------------------
    function getTotalDuration() {
      return state.scenes.reduce((sum, sc) => sum + Number(sc.duration || 4), 0);
    }

    function getSceneTimeBounds(index) {
      let start = 0;
      for (let i = 0; i < index; i++) {
        start += Number(state.scenes[i].duration || 4);
      }
      const end = start + Number(state.scenes[index]?.duration || 4);
      return { start, end };
    }

    function getSceneAtTime(t) {
      if (!state.scenes.length) {
        return { index: 0, scene: null, start: 0, end: 0, localTime: 0 };
      }
      let cursor = 0;
      for (let i = 0; i < state.scenes.length; i++) {
        const dur = Number(state.scenes[i].duration || 4);
        const end = cursor + dur;
        if (t < end || i === state.scenes.length - 1) {
          return {
            index: i,
            scene: state.scenes[i],
            start: cursor,
            end,
            localTime: Math.max(0, t - cursor)
          };
        }
        cursor = end;
      }
      const lastIdx = state.scenes.length - 1;
      const bounds = getSceneTimeBounds(lastIdx);
      return {
        index: lastIdx,
        scene: state.scenes[lastIdx],
        start: bounds.start,
        end: bounds.end,
        localTime: Math.max(0, t - bounds.start)
      };
    }

    function estimateSpeechDuration(text, rate = 0.96) {
      const clean = sanitizeTextForIndonesianSpeech(stripProsodyTagsForSubtitle(text));
      if (!clean) return 4.0;
      const words = clean.split(/\s+/).filter(Boolean).length;
      const rawSeconds = (words / (2.30 * rate)) + 1.25;
      return Math.min(15, Math.max(3.0, Math.round(rawSeconds * 2) / 2));
    }

    function rebuildSubtitlesFromVoice() {
      const segments = [];
      let cursor = 0;

      state.scenes.forEach((scene, sIdx) => {
        const dur = Number(scene.duration || 4);
        const rawText = stripProsodyTagsForSubtitle(scene.narration || '');

        if (!rawText) {
          cursor += dur;
          return;
        }

        let chunks = [];
        if (state.subtitle.autoSplitShort) {
          const words = rawText.split(/\s+/).filter(Boolean);
          const chunkSize = 5;
          for (let i = 0; i < words.length; i += chunkSize) {
            chunks.push(words.slice(i, i + chunkSize).join(' '));
          }
        } else {
          chunks = rawText
            .split(/(?<=[.!?])\s+/)
            .map(s => s.trim())
            .filter(Boolean);
          if (chunks.length === 0) chunks = [rawText];
        }

        const envelope = scene.audioBuffer
          ? analyzeSpeechEnvelope(scene.audioBuffer, rawText, cursor)
          : null;

        const pad = Math.min(0.2, dur * 0.05);
        const speakWindow = Math.max(0.5, dur - pad * 2);
        const totalChars = chunks.reduce((acc, c) => acc + c.length, 0) || 1;
        let charCursor = 0;

        chunks.forEach((chunkText, cIdx) => {
          const startRatio = charCursor / totalChars;
          const endRatio = (charCursor + chunkText.length) / totalChars;

          const segStart = envelope
            ? envelope.mapEnergyRatioToTime(startRatio)
            : cursor + pad + startRatio * speakWindow;
          const segEnd = envelope
            ? Math.max(segStart + 0.18, envelope.mapEnergyRatioToTime(endRatio))
            : cursor + pad + endRatio * speakWindow;

          const words = chunkText.split(/\s+/).filter(Boolean);
          const wordTotalChars = words.reduce((a, w) => a + w.length, 0) || 1;
          let wCharCursor = 0;
          const wordTimings = words.map((w) => {
            const wStartFrac = wCharCursor / wordTotalChars;
            const wEndFrac = (wCharCursor + w.length) / wordTotalChars;
            const globalStartRatio = startRatio + wStartFrac * (endRatio - startRatio);
            const globalEndRatio = startRatio + wEndFrac * (endRatio - startRatio);

            const item = {
              word: w,
              start: envelope
                ? envelope.mapEnergyRatioToTime(globalStartRatio)
                : segStart + wStartFrac * (segEnd - segStart),
              end: envelope
                ? envelope.mapEnergyRatioToTime(globalEndRatio)
                : segStart + wEndFrac * (segEnd - segStart)
            };
            wCharCursor += w.length;
            return item;
          });

          segments.push({
            id: `sub-${scene.id}-${cIdx}`,
            sceneId: scene.id,
            sceneIndex: sIdx,
            start: segStart,
            end: segEnd,
            text: chunkText,
            words: wordTimings
          });

          charCursor += chunkText.length;
        });

        cursor += dur;
      });

      state.subtitle.segments = segments;
      renderSubtitleListUI();
      renderTimeline();
    }

    function updateSegmentWords(seg) {
      const words = (seg.text || '').split(/\s+/).filter(Boolean);
      const segDur = Math.max(0.2, seg.end - seg.start);
      const totalChars = words.reduce((a, w) => a + w.length, 0) || 1;
      let wCursor = seg.start;
      seg.words = words.map((w) => {
        const wDur = segDur * (w.length / totalChars);
        const item = { word: w, start: wCursor, end: wCursor + wDur };
        wCursor += wDur;
        return item;
      });
    }

    function formatTimecode(seconds) {
      const s = Math.max(0, seconds);
      const mins = Math.floor(s / 60);
      const secs = Math.floor(s % 60);
      const tenths = Math.floor((s % 1) * 10);
      return `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}.${tenths}`;
    }

    function formatSrtTime(seconds, useComma = true) {
      const s = Math.max(0, seconds);
      const hrs = Math.floor(s / 3600);
      const mins = Math.floor((s % 3600) / 60);
      const secs = Math.floor(s % 60);
      const ms = Math.floor((s % 1) * 1000);
      const sep = useComma ? ',' : '.';
      return `${String(hrs).padStart(2, '0')}:${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}${sep}${String(ms).padStart(3, '0')}`;
    }


    async function renderOfflineMasterAudioBuffer(totalDurationSec, sampleRate = 44100) {
      const totalSamples = Math.max(sampleRate, Math.ceil(totalDurationSec * sampleRate));
      const offlineCtx = new OfflineAudioContext(2, totalSamples, sampleRate);

      const bgmBus = offlineCtx.createGain();
      const baseBgmGain = state.voice.bgmVolume * 0.35;
      bgmBus.gain.setValueAtTime(baseBgmGain, 0);
      bgmBus.connect(offlineCtx.destination);

      state.scenes.forEach((sc, idx) => {
        const bounds = getSceneTimeBounds(idx);
        const hasAudioBuf = !!sc.audioBuffer;
        const speakStart = bounds.start + 0.12;
        const speakEnd = hasAudioBuf
          ? Math.min(bounds.end, speakStart + sc.audioBuffer.duration)
          : Math.max(speakStart + 0.5, bounds.end - 0.35);

        if (((sc.narration || '').trim().length > 0 || hasAudioBuf) && state.voice.bgmType !== 'none') {
          bgmBus.gain.setValueAtTime(baseBgmGain, Math.max(0, speakStart - 0.12));
          bgmBus.gain.linearRampToValueAtTime(baseBgmGain * 0.20, speakStart + 0.05);
          bgmBus.gain.setValueAtTime(baseBgmGain * 0.20, Math.max(speakStart + 0.1, speakEnd - 0.1));
          bgmBus.gain.linearRampToValueAtTime(baseBgmGain, Math.min(totalDurationSec, speakEnd + 0.25));
        }

        if (hasAudioBuf) {
          const voiceSrc = offlineCtx.createBufferSource();
          voiceSrc.buffer = sc.audioBuffer;
          const vGain = offlineCtx.createGain();
          vGain.gain.value = state.voice.volume;
          voiceSrc.connect(vGain);
          vGain.connect(offlineCtx.destination);
          voiceSrc.start(speakStart);
        }
      });

      if (state.voice.bgmType !== 'none') {
        if (state.voice.bgmType === 'rain-piano') {
          const rainBuf = offlineCtx.createBuffer(1, totalSamples, sampleRate);
          const data = rainBuf.getChannelData(0);
          let b0 = 0, b1 = 0, b2 = 0;
          for (let i = 0; i < totalSamples; i++) {
            const white = Math.random() * 2 - 1;
            b0 = 0.99765 * b0 + white * 0.0990460;
            b1 = 0.96300 * b1 + white * 0.2965164;
            b2 = 0.57000 * b2 + white * 1.0526913;
            data[i] = (b0 + b1 + b2 + white * 0.1848) * 0.042;
          }
          const rainSrc = offlineCtx.createBufferSource();
          rainSrc.buffer = rainBuf;
          const lp = offlineCtx.createBiquadFilter();
          lp.type = 'lowpass';
          lp.frequency.value = 920;
          rainSrc.connect(lp);
          lp.connect(bgmBus);
          rainSrc.start(0);
        }

        const progressions = {
          'lofi-pastel': [
            [174.61, 220.00, 261.63, 329.63],
            [164.81, 196.00, 246.94, 293.66],
            [146.83, 174.61, 220.00, 261.63],
            [130.81, 196.00, 246.94, 329.63]
          ],
          'music-box': [
            [523.25, 659.25, 783.99],
            [493.88, 587.33, 783.99],
            [440.00, 523.25, 659.25],
            [392.00, 493.88, 659.25]
          ],
          'rain-piano': [
            [261.63, 329.63, 392.00],
            [220.00, 261.63, 329.63],
            [174.61, 220.00, 349.23],
            [196.00, 246.94, 392.00]
          ]
        };

        const chords = progressions[state.voice.bgmType] || progressions['lofi-pastel'];
        const stepInterval = 2.2;
        const totalSteps = Math.ceil(totalDurationSec / stepInterval);

        for (let step = 0; step < totalSteps; step++) {
          const t0 = step * stepInterval;
          const chord = chords[step % chords.length];
          chord.forEach((freq, idx) => {
            const osc = offlineCtx.createOscillator();
            const nGain = offlineCtx.createGain();
            const filter = offlineCtx.createBiquadFilter();

            osc.type = state.voice.bgmType === 'music-box' ? 'sine' : 'triangle';
            const offset = state.voice.bgmType === 'music-box' ? idx * 0.34 : idx * 0.05;
            osc.frequency.setValueAtTime(freq, t0 + offset);

            filter.type = 'lowpass';
            filter.frequency.setValueAtTime(state.voice.bgmType === 'music-box' ? 2400 : 880, t0 + offset);

            nGain.gain.setValueAtTime(0.0001, t0 + offset);
            nGain.gain.linearRampToValueAtTime(0.16 / chord.length, t0 + offset + 0.18);
            nGain.gain.exponentialRampToValueAtTime(0.0001, t0 + offset + 2.15);

            osc.connect(filter);
            filter.connect(nGain);
            nGain.connect(bgmBus);

            osc.start(t0 + offset);
            osc.stop(Math.min(totalDurationSec + 0.1, t0 + offset + 2.2));
          });
        }
      }

      return await offlineCtx.startRendering();
    }

    async function exportTrueMp4WebCodecs(width, height, fps, totalDurationSec, onProgress) {
      const candidateCodecs = ['avc1.42001f', 'avc1.420028', 'avc1.42002a', 'avc1.4d002a'];

      let selectedAvcCodec = null;
      const bitrate = width * height > 1280 * 720 ? 6_500_000 : 3_800_000;

      for (const codec of candidateCodecs) {
        try {
          const support = await VideoEncoder.isConfigSupported({
            codec,
            width,
            height,
            bitrate,
            framerate: fps
          });
          if (support && support.supported) {
            selectedAvcCodec = codec;
            break;
          }
        } catch (e) {}
      }

      if (!selectedAvcCodec) {
        throw new Error('H.264 VideoEncoder config not supported on this device');
      }

      const sampleRate = 44100;
      const numberOfChannels = 2;

      const muxer = new Mp4Muxer.Muxer({
        target: new Mp4Muxer.ArrayBufferTarget(),
        video: {
          codec: 'avc',
          width,
          height
        },
        audio: {
          codec: 'aac',
          sampleRate,
          numberOfChannels
        },
        fastStart: 'in-memory'
      });

      const videoEncoder = new VideoEncoder({
        output: (chunk, meta) => muxer.addVideoChunk(chunk, meta),
        error: (err) => console.error('VideoEncoder error:', err)
      });

      videoEncoder.configure({
        codec: selectedAvcCodec,
        width,
        height,
        bitrate,
        framerate: fps
      });

      const audioEncoder = new AudioEncoder({
        output: (chunk, meta) => muxer.addAudioChunk(chunk, meta),
        error: (err) => console.error('AudioEncoder error:', err)
      });

      audioEncoder.configure({
        codec: 'mp4a.40.2',
        sampleRate,
        numberOfChannels,
        bitrate: 128_000
      });

      onProgress(5, 1, 'Merender trek audio AAC stereo (BGM Auto-Ducking)...');
      const renderedAudio = await renderOfflineMasterAudioBuffer(totalDurationSec, sampleRate);

      if (state.exportSettings.cancelRequested) {
        videoEncoder.close();
        audioEncoder.close();
        return null;
      }

      const leftCh = renderedAudio.getChannelData(0);
      const rightCh = renderedAudio.getChannelData(1);
      const chunkFrames = 1024;
      const totalAudioFrames = renderedAudio.length;

      for (let offset = 0; offset < totalAudioFrames; offset += chunkFrames) {
        if (state.exportSettings.cancelRequested) {
          videoEncoder.close();
          audioEncoder.close();
          return null;
        }
        const framesInChunk = Math.min(chunkFrames, totalAudioFrames - offset);
        const planarBuffer = new Float32Array(framesInChunk * 2);
        planarBuffer.set(leftCh.subarray(offset, offset + framesInChunk), 0);
        planarBuffer.set(rightCh.subarray(offset, offset + framesInChunk), framesInChunk);

        const audioData = new AudioData({
          format: 'f32-planar',
          sampleRate,
          numberOfFrames: framesInChunk,
          numberOfChannels: 2,
          timestamp: Math.round((offset / sampleRate) * 1_000_000),
          data: planarBuffer
        });

        audioEncoder.encode(audioData);
        audioData.close();
      }

      onProgress(18, 1, `Encoding video H.264 (${selectedAvcCodec}) @ ${width}x${height} ${fps}fps...`);

      const offscreenCanvas = document.createElement('canvas');
      offscreenCanvas.width = width;
      offscreenCanvas.height = height;
      const offscreenCtx = offscreenCanvas.getContext('2d');

      const totalFrames = Math.ceil(totalDurationSec * fps);
      const frameDurationUs = Math.round(1_000_000 / fps);

      for (let f = 0; f < totalFrames; f++) {
        if (state.exportSettings.cancelRequested) {
          videoEncoder.close();
          audioEncoder.close();
          return null;
        }

        const t = f / fps;
        renderMasterFrameAtTime(offscreenCtx, t, width, height);

        const videoFrame = new VideoFrame(offscreenCanvas, {
          timestamp: f * frameDurationUs,
          duration: frameDurationUs
        });

        const isKeyFrame = f % (fps * 2) === 0;
        videoEncoder.encode(videoFrame, { keyFrame: isKeyFrame });
        videoFrame.close();

        if (f % 4 === 0 || f === totalFrames - 1) {
          const pct = 18 + Math.round(((f + 1) / totalFrames) * 77);
          const sceneInfo = getSceneAtTime(t);
          onProgress(
            pct,
            sceneInfo.index + 1,
            `Merender frame ${f + 1}/${totalFrames} (${width}x${height} • ${fps} FPS)...`
          );
          await new Promise(r => setTimeout(r, 0));
        }
      }

      onProgress(96, state.scenes.length, 'Menyelesaikan kontainer MP4 (FastStart)...');
      await videoEncoder.flush();
      await audioEncoder.flush();
      videoEncoder.close();
      audioEncoder.close();

      muxer.finalize();
      return new Blob([muxer.target.buffer], { type: 'video/mp4' });
    }

    async function exportMp4MediaRecorderFallback(width, height, fps, totalDurationSec, onProgress) {
      const offscreenCanvas = document.createElement('canvas');
      offscreenCanvas.width = width;
      offscreenCanvas.height = height;
      const offscreenCtx = offscreenCanvas.getContext('2d');

      const videoStream = offscreenCanvas.captureStream(fps);
      const tracks = [...videoStream.getVideoTracks()];

      bgmEngine.start();
      if (bgmEngine.ctx && bgmEngine.masterGain) {
        const dest = bgmEngine.ctx.createMediaStreamDestination();
        bgmEngine.masterGain.connect(dest);
        tracks.push(...dest.stream.getAudioTracks());
      }

      const combinedStream = new MediaStream(tracks);
      const mimeCandidates = [
        'video/mp4;codecs=avc1,mp4a.40.2',
        'video/mp4',
        'video/webm;codecs=vp9,opus',
        'video/webm'
      ];
      const mimeType = mimeCandidates.find(m => typeof MediaRecorder !== 'undefined' && MediaRecorder.isTypeSupported(m)) || '';

      return new Promise((resolve) => {
        const chunks = [];
        const recorder = mimeType ? new MediaRecorder(combinedStream, { mimeType }) : new MediaRecorder(combinedStream);

        recorder.ondataavailable = (e) => {
          if (e.data && e.data.size > 0) chunks.push(e.data);
        };

        recorder.onstop = () => {
          bgmEngine.stop();
          if (state.exportSettings.cancelRequested) {
            resolve(null);
            return;
          }
          resolve(new Blob(chunks, { type: mimeType || 'video/mp4' }));
        };

        recorder.start(100);
        const startPerf = performance.now();

        const step = () => {
          if (state.exportSettings.cancelRequested) {
            if (recorder.state === 'recording') recorder.stop();
            return;
          }

          const elapsedSec = (performance.now() - startPerf) / 1000;
          const clampedT = Math.min(totalDurationSec, elapsedSec);
          renderMasterFrameAtTime(offscreenCtx, clampedT, width, height);

          const pct = Math.min(99, Math.round((clampedT / totalDurationSec) * 100));
          const info = getSceneAtTime(clampedT);
          onProgress(pct, info.index + 1, `Merekam real-time fallback (${Math.round(clampedT)}s / ${Math.round(totalDurationSec)}s)...`);

          if (elapsedSec >= totalDurationSec) {
            if (recorder.state === 'recording') recorder.stop();
          } else {
            requestAnimationFrame(step);
          }
        };

        requestAnimationFrame(step);
      });
    }

    async function startTrueMp4Export() {
      if (state.exportSettings.isExporting) return;

      pausePlayback();

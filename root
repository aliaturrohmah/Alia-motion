<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Alia Motion Studio — Text-to-Video, Sulih Suara Native & Export MP4</title>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Google Fonts: Plus Jakarta Sans, Nunito, Quicksand, Playfair Display, JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Nunito:wght@500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet" />

  <!-- Lucide Icons CDN -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- MP4 Muxer via esm.sh CDN for True H.264 + AAC .MP4 Export -->
  <script type="module">
    import * as Mp4MuxerModule from 'https://esm.sh/mp4-muxer@5.1.3';
    window.Mp4Muxer = Mp4MuxerModule;
  </script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', '"Nunito"', 'sans-serif'],
            cute: ['"Nunito"', '"Quicksand"', 'sans-serif'],
            serif: ['"Playfair Display"', 'serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          },
          colors: {
            warmcream: '#FFF9FB',
            inkslate: '#2D3748',
            sakura: '#FF8FB1',
            lavender: '#B892FF',
            skypastel: '#7BDFF2',
            mintpastel: '#95D5B2',
            pastel: {
              lavender: '#EDE2FF',
              lavenderLight: '#F8F3FF',
              blush: '#FFD6E5',
              blushLight: '#FFF0F6',
              mint: '#C8F2DC',
              mintLight: '#F0FBF5',
              sky: '#CBEFF8',
              skyLight: '#EFFAFC',
            }
          },
          borderRadius: {
            'card': '20px',
            'card-lg': '24px',
            'pill': '18px',
          },
          boxShadow: {
            'pastel': '0 10px 28px -8px rgba(184, 146, 255, 0.18)',
            'pastel-sm': '0 4px 14px -4px rgba(255, 143, 177, 0.18)',
            'glass': '0 8px 32px 0 rgba(184, 146, 255, 0.12)',
          }
        }
      }
    };
  </script>

  <style>
    body {
      background-color: #FFF9FB;
      background-image:
        radial-gradient(at 0% 0%, rgba(184, 146, 255, 0.22) 0px, transparent 50%),
        radial-gradient(at 100% 0%, rgba(255, 143, 177, 0.22) 0px, transparent 50%),
        radial-gradient(at 50% 100%, rgba(123, 223, 242, 0.20) 0px, transparent 55%);
      color: #2D3748;
      font-family: 'Plus Jakarta Sans', 'Nunito', sans-serif;
      overflow-x: hidden;
    }

    .glass-card {
      background: #FFFFFF;
      border-radius: 20px;
    }

    /* Pastel Range Sliders */
    input[type="range"] {
      -webkit-appearance: none;
      appearance: none;
      background: #EDE2FF;
      height: 6px;
      border-radius: 999px;
      outline: none;
    }
    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: linear-gradient(135deg, #B892FF, #FF8FB1);
      cursor: pointer;
      border: 2px solid #FFFFFF;
      box-shadow: 0 2px 6px rgba(184, 146, 255, 0.42);
      transition: transform 0.15s ease;
    }
    input[type="range"]::-webkit-slider-thumb:hover {
      transform: scale(1.15);
    }

    /* Custom Scrollbars */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #F6F0FF;
      border-radius: 999px;
    }
    ::-webkit-scrollbar-thumb {
      background: #D6BCFA;
      border-radius: 999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #9F7AEA;
    }

    @keyframes floatSlow {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-3px); }
    }
    .animate-float {
      animation: floatSlow 3.2s ease-in-out infinite;
    }

    @keyframes pulseBar {
      0%, 100% { transform: scaleY(0.32); }
      50% { transform: scaleY(1); }
    }
    .wave-bar-active {
      animation: pulseBar 0.5s ease-in-out infinite;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col text-inkslate selection:bg-pastel-lavender selection:text-purple-950">

  <!-- =====================================================================
       1. TOP STUDIO HEADER BAR
  ====================================================================== -->
  <header class="sticky top-0 z-30 bg-warmcream/90 backdrop-blur-md border-b border-pastel-lavender/80 px-4 lg:px-6 py-3 shadow-pastel-sm">
    <div class="max-w-[1680px] mx-auto flex flex-wrap items-center justify-between gap-3">
      
      <!-- Brand Logo & Editable Project Title -->
      <div class="flex items-center gap-3 min-w-0 flex-1 sm:flex-initial">
        <div class="w-10 h-10 rounded-[20px] bg-gradient-to-br from-purple-400 via-pink-300 to-sky-300 flex items-center justify-center text-white shadow-pastel-sm shrink-0 animate-float">
          <i data-lucide="clapperboard" class="w-5 h-5"></i>
        </div>
        <div class="min-w-0">
          <div class="flex items-center gap-2">
            <span class="font-cute font-extrabold text-base sm:text-lg bg-gradient-to-r from-[#9B6BFF] via-[#FF709D] to-[#48BFE3] bg-clip-text text-transparent tracking-tight">
              Alia Motion Studio
            </span>
            <span class="hidden md:inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-pastel-lavender text-purple-900">
              Native Human Voice & MP4
            </span>
          </div>
          <div class="flex items-center gap-1.5 mt-0.5">
            <i data-lucide="pencil" class="w-3 h-3 text-purple-400 shrink-0"></i>
            <input
              id="projectTitleInput"
              type="text"
              value="Cerita Senja di Kafe Pastel"
              aria-label="Judul Proyek"
              class="text-xs sm:text-sm font-semibold text-inkslate bg-transparent hover:bg-pastel-lavenderLight focus:bg-pastel-lavenderLight focus:outline-none focus:ring-2 focus:ring-pastel-lavender rounded-xl px-2 py-0.5 w-44 sm:w-64 truncate transition"
            />
          </div>
        </div>
      </div>

      <!-- Right Controls: Preset Loader, Generate All & Prominent MP4 Export -->
      <div class="flex items-center gap-2 sm:gap-2.5 flex-wrap">
        <!-- Quick Preset Selector -->
        <div class="relative">
          <select
            id="presetSelector"
            aria-label="Muat Contoh Proyek"
            class="appearance-none bg-pastel-lavenderLight hover:bg-pastel-lavender/60 text-purple-950 text-xs sm:text-sm font-semibold rounded-[20px] pl-3.5 pr-8 py-2.5 border border-pastel-lavender focus:outline-none focus:ring-2 focus:ring-purple-400 cursor-pointer transition"
          >
            <option value="senja-sakura">🌸 Contoh: Senja Pastel & Sakura</option>
            <option value="malam-lofi">🌧️ Contoh: Malam Hujan Lo-Fi</option>
            <option value="motivasi-pagi">☀️ Contoh: Motivasi Pagi Estetik</option>
          </select>
          <i data-lucide="chevron-down" class="w-4 h-4 text-purple-600 pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2"></i>
        </div>

        <!-- Generate All Button -->
        <button
          id="btnGenerateAll"
          type="button"
          class="inline-flex items-center gap-1.5 px-3.5 py-2.5 rounded-[20px] text-xs sm:text-sm font-bold text-purple-900 bg-pastel-blushLight hover:bg-pastel-blush/70 border border-pastel-blush shadow-pastel-sm active:scale-[0.98] transition cursor-pointer"
        >
          <i data-lucide="sparkles" class="w-4 h-4 text-pink-500"></i>
          <span>Generate Semua</span>
        </button>

        <!-- Prominent Primary CTA: Export Video .MP4 -->
        <button
          id="btnHeaderExportMp4"
          type="button"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-[20px] text-xs sm:text-sm font-bold text-white bg-gradient-to-r from-purple-500 via-pink-500 to-rose-400 hover:opacity-95 shadow-pastel active:scale-[0.98] transition cursor-pointer"
        >
          <span>🎬 Export Video .MP4</span>
        </button>
      </div>
    </div>
  </header>

  <!-- =====================================================================
       MAIN 3-COLUMN CREATOR STUDIO WORKSPACE
  ====================================================================== -->
  <main class="flex-1 max-w-[1680px] w-full mx-auto p-3 sm:p-4 lg:p-5 grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-5">

    <!-- ===================================================================
         COLUMN 1: LEFT SIDEBAR — STORYBOARD SCENES MANAGER
    ==================================================================== -->
    <aside class="lg:col-span-3 glass-card border border-pastel-lavender shadow-pastel flex flex-col overflow-hidden lg:max-h-[calc(100vh-96px)]">
      
      <!-- Sidebar Header -->
      <div class="p-4 border-b border-pastel-lavender/70 bg-pastel-lavenderLight/50 flex items-center justify-between gap-2 shrink-0">
        <div>
          <h2 class="font-cute font-bold text-sm sm:text-base text-inkslate flex items-center gap-1.5">
            <i data-lucide="film" class="w-4 h-4 text-purple-600"></i>
            Storyboard Adegan
          </h2>
          <p class="text-[11px] text-slate-500">Kelola urutan & ilustrasi adegan</p>
        </div>
        <button
          id="btnAddScene"
          type="button"
          class="inline-flex items-center gap-1 px-3 py-1.5 rounded-[16px] text-xs font-bold bg-purple-600 hover:bg-purple-700 text-white shadow-pastel-sm transition cursor-pointer"
        >
          <i data-lucide="plus" class="w-3.5 h-3.5"></i>
          <span>Adegan</span>
        </button>
      </div>

      <!-- Smart Script-to-Scenes Button -->
      <div class="px-4 pt-3 shrink-0">
        <button
          id="btnOpenSplitModal"
          type="button"
          class="w-full py-2.5 px-3 rounded-[16px] text-xs font-bold bg-gradient-to-r from-pastel-blushLight to-pastel-lavenderLight hover:from-pastel-blush/70 hover:to-pastel-lavender/70 text-purple-950 border border-pastel-blush flex items-center justify-center gap-1.5 transition cursor-pointer"
        >
          <span>🪄 Pecah Naskah Otomatis</span>
        </button>
      </div>

      <!-- Scrollable Scenes List + Active Scene Editor -->
      <div class="flex-1 overflow-y-auto p-4 space-y-4">
        
        <!-- Scene List -->
        <div id="sceneListContainer" class="space-y-2">
          <!-- Populated dynamically via JS -->
        </div>

        <!-- Active Scene Quick Properties Card -->
        <div class="p-3.5 rounded-[22px] bg-pastel-lavenderLight/55 border border-pastel-lavender space-y-3">
          <div class="flex items-center justify-between">
            <span id="activeSceneBadge" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-white text-purple-900 border border-pastel-lavender">
              ✨ Mengedit Adegan 1
            </span>
            <span id="activeSceneDurationBadge" class="text-[11px] font-mono font-bold text-purple-700">
              5.2d
            </span>
          </div>

          <!-- Visual Prompt -->
          <div>
            <label for="scenePromptInput" class="block text-[11px] font-bold text-inkslate mb-1">
              Deskripsi Visual Adegan
            </label>
            <textarea
              id="scenePromptInput"
              rows="3"
              placeholder="Contoh: Langit senja pastel dengan kelopak sakura berterbangan dan kucing lucu..."
              class="w-full rounded-[16px] border border-pastel-lavender bg-white p-2.5 text-xs text-inkslate placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-purple-400 transition resize-none"
            ></textarea>
            
            <!-- Quick Aesthetic Chips -->
            <div class="flex flex-wrap gap-1 mt-1.5">
              <button type="button" data-chip="kelopak sakura berterbangan" class="prompt-chip px-2 py-0.5 rounded-full text-[10px] font-semibold bg-white hover:bg-pastel-blush/60 text-slate-600 border border-pastel-lavender/80 transition cursor-pointer">+ Sakura</button>
              <button type="button" data-chip="kucing lucu duduk santai" class="prompt-chip px-2 py-0.5 rounded-full text-[10px] font-semibold bg-white hover:bg-pastel-blush/60 text-slate-600 border border-pastel-lavender/80 transition cursor-pointer">+ Kucing</button>
              <button type="button" data-chip="secangkir kopi hangat di kafe" class="prompt-chip px-2 py-0.5 rounded-full text-[10px] font-semibold bg-white hover:bg-pastel-sky/60 text-slate-600 border border-pastel-lavender/80 transition cursor-pointer">+ Kopi</button>
              <button type="button" data-chip="taman bunga mekar indah" class="prompt-chip px-2 py-0.5 rounded-full text-[10px] font-semibold bg-white hover:bg-pastel-mint/60 text-slate-600 border border-pastel-lavender/80 transition cursor-pointer">+ Bunga</button>
              <button type="button" data-chip="bulan sabit dan bintang berkilau" class="prompt-chip px-2 py-0.5 rounded-full text-[10px] font-semibold bg-white hover:bg-pastel-lavender/60 text-slate-600 border border-pastel-lavender/80 transition cursor-pointer">+ Bulan</button>
            </div>
          </div>

          <!-- Keyword Scene Illustration Override -->
          <div>
            <label for="sceneIllustrationSelect" class="block text-[11px] font-bold text-inkslate mb-1">
              Ilustrasi Vektor Adegan (Override)
            </label>
            <select id="sceneIllustrationSelect" class="w-full rounded-[14px] border border-pastel-lavender bg-white px-2.5 py-2 text-xs font-semibold text-inkslate focus:outline-none focus:ring-2 focus:ring-purple-400">
              <option value="auto">🪄 Otomatis Deteksi dari Teks</option>
              <option value="cat">🐱 Kucing Lucu</option>
              <option value="coffee">☕ Secangkir Kopi & Kafe</option>
              <option value="book">📖 Buku Cerita Terbuka</option>
              <option value="city">🏙️ Siluet Kota Malam</option>
              <option value="ocean">🌊 Ombak Laut Pastel</option>
              <option value="flowers">🌷 Taman Bunga Mekar</option>
              <option value="hearts">💖 Hati Pastel Melayang</option>
              <option value="moon">🌙 Bulan Sabit & Bintang</option>
              <option value="none">🚫 Pemandangan Murni</option>
            </select>
          </div>

          <!-- Camera Motion -->
          <div>
            <label for="sceneCameraSelect" class="block text-[11px] font-bold text-inkslate mb-1">
              Gerakan Kamera
            </label>
            <select id="sceneCameraSelect" class="w-full rounded-[14px] border border-pastel-lavender bg-white px-2.5 py-2 text-xs font-semibold text-inkslate focus:outline-none focus:ring-2 focus:ring-purple-400">
              <option value="zoom-in">🔍 Smooth Zoom In</option>
              <option value="pan-right">➡️ Gentle Pan Right</option>
              <option value="floating-drift">☁️ Floating Drift</option>
              <option value="parallax-sway">🍃 Parallax Sway</option>
              <option value="static">🧘 Static Calm</option>
            </select>
          </div>

          <!-- Duration Slider -->
          <div>
            <div class="flex items-center justify-between mb-1">
              <label for="sceneDurationRange" class="text-[11px] font-bold text-inkslate">
                Durasi Adegan
              </label>
              <span id="sceneDurationText" class="text-[11px] font-mono font-bold text-purple-700">5.2 detik</span>
            </div>
            <input id="sceneDurationRange" type="range" min="2.5" max="15" step="0.5" value="5.2" class="w-full" />
          </div>
        </div>

      </div>
    </aside>

    <!-- ===================================================================
         COLUMN 2: CENTER STAGE — 60FPS CANVAS PREVIEW + 3-TRACK TIMELINE
    ==================================================================== -->
    <section class="lg:col-span-5 xl:col-span-6 flex flex-col gap-4 min-w-0">
      
      <!-- Canvas Preview Stage Card -->
      <div class="glass-card border border-pastel-lavender shadow-pastel p-3.5 sm:p-4 flex flex-col items-center justify-between relative overflow-hidden">
        
        <!-- Top Stage Status Pill Bar -->
        <div class="w-full flex items-center justify-between gap-2 mb-3 px-1 flex-wrap">
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-pastel-lavenderLight text-purple-900 border border-pastel-lavender">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span id="stageSceneIndicator">Adegan 1 / 3</span>
            </span>
            <span id="stageStyleBadge" class="hidden sm:inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-semibold bg-pastel-blushLight text-rose-800 border border-pastel-blush">
              Pastel Anime Lo-Fi
            </span>
          </div>

          <div class="flex items-center gap-1.5 text-xs font-mono text-slate-600">
            <select
              id="stageAspectQuickSelect"
              aria-label="Pilih Rasio Platform"
              title="Pilih Rasio Video (TikTok, Shorts, Reels, YouTube)"
              class="px-2.5 py-1 rounded-xl bg-pastel-skyLight hover:bg-pastel-sky/70 border border-pastel-sky font-sans font-bold text-sky-950 text-[11px] focus:outline-none focus:ring-2 focus:ring-sky-400 cursor-pointer transition"
            >
              <option value="16:9">🖥️ 16:9 YouTube</option>
              <option value="9:16">📱 9:16 TikTok / Shorts / Reels</option>
              <option value="4:5">🖼️ 4:5 IG / FB Portrait</option>
              <option value="1:1">⬜ 1:1 IG / FB Square</option>
              <option value="21:9">🎬 21:9 Cinematic</option>
            </select>
            <button
              id="btnQuickSafeZone"
              type="button"
              title="Tampilkan/Sembunyikan Panduan Zona Aman TikTok, Shorts & Reels"
              class="px-2 py-1 rounded-xl bg-white hover:bg-pastel-blushLight border border-pastel-lavender font-sans font-bold text-[11px] text-purple-900 transition cursor-pointer"
            >
              🛡️ Safe Zone
            </button>
            <span class="hidden sm:inline-block px-2 py-0.5 rounded-xl bg-pastel-mintLight border border-pastel-mint font-bold text-emerald-900">60 FPS</span>
          </div>
        </div>

        <!-- Responsive Canvas Wrapper -->
        <div
          id="canvasStageContainer"
          class="w-full bg-gradient-to-br from-pastel-lavenderLight via-pastel-blushLight/60 to-pastel-skyLight/60 rounded-[22px] border border-pastel-lavender flex items-center justify-center p-2.5 sm:p-4 min-h-[280px] sm:min-h-[360px] lg:min-h-[410px] relative"
        >
          <canvas
            id="studioCanvas"
            class="rounded-[20px] shadow-lg max-w-full max-h-[420px] block bg-purple-950"
          ></canvas>
        </div>

        <!-- Player Transport Bar -->
        <div class="w-full mt-3.5 pt-3 border-t border-pastel-lavender/70 flex flex-wrap items-center justify-between gap-2.5 px-1">
          
          <!-- Playback Controls -->
          <div class="flex items-center gap-1.5">
            <button
              id="btnPrevScene"
              type="button"
              title="Adegan Sebelumnya"
              class="p-2.5 rounded-[16px] bg-pastel-lavenderLight hover:bg-pastel-lavender text-purple-900 transition cursor-pointer"
            >
              <i data-lucide="skip-back" class="w-4 h-4"></i>
            </button>

            <button
              id="btnPlayPause"
              type="button"
              class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-[18px] text-xs sm:text-sm font-bold text-white bg-gradient-to-r from-[#B892FF] to-[#FF8FB1] hover:opacity-95 shadow-pastel-sm active:scale-95 transition cursor-pointer"
            >
              <i id="playPauseIcon" data-lucide="play" class="w-4 h-4"></i>
              <span id="playPauseLabel">Putar</span>
            </button>

            <button
              id="btnStopReset"
              type="button"
              title="Hentikan & Kembali ke Awal"
              class="p-2.5 rounded-[16px] bg-pastel-lavenderLight hover:bg-pastel-lavender text-purple-900 transition cursor-pointer"
            >
              <i data-lucide="square" class="w-4 h-4"></i>
            </button>

            <button
              id="btnNextScene"
              type="button"
              title="Adegan Berikutnya"
              class="p-2.5 rounded-[16px] bg-pastel-lavenderLight hover:bg-pastel-lavender text-purple-900 transition cursor-pointer"
            >
              <i data-lucide="skip-forward" class="w-4 h-4"></i>
            </button>

            <button
              id="btnToggleLoop"
              type="button"
              title="Ulang Otomatis (Loop)"
              class="p-2.5 rounded-[16px] bg-white hover:bg-pastel-lavenderLight text-slate-500 border border-pastel-lavender transition cursor-pointer"
            >
              <i data-lucide="repeat" class="w-4 h-4"></i>
            </button>
          </div>

          <!-- Timecode & Live Audio Visualizer -->
          <div class="flex items-center gap-3">
            <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-[16px] bg-pastel-lavenderLight/70 border border-pastel-lavender font-mono text-xs font-bold text-purple-950">
              <span id="currentTimecode">00:00.0</span>
              <span class="text-purple-400">/</span>
              <span id="totalTimecode">00:15.6</span>
            </div>

            <div class="hidden sm:flex items-end gap-1 h-7 px-2.5 py-1 rounded-[14px] bg-pastel-blushLight/70 border border-pastel-blush" title="Level Audio">
              <span class="audio-bar w-1 h-2 bg-[#B892FF] rounded-full transition-all duration-75"></span>
              <span class="audio-bar w-1 h-3 bg-[#FF8FB1] rounded-full transition-all duration-75"></span>
              <span class="audio-bar w-1 h-2.5 bg-[#7BDFF2] rounded-full transition-all duration-75"></span>
              <span class="audio-bar w-1 h-4 bg-[#95D5B2] rounded-full transition-all duration-75"></span>
              <span class="audio-bar w-1 h-2 bg-[#B892FF] rounded-full transition-all duration-75"></span>
              <span class="audio-bar w-1 h-3 bg-[#FF8FB1] rounded-full transition-all duration-75"></span>
            </div>
          </div>

        </div>
      </div>

      <!-- Interactive 3-Track Studio Timeline -->
      <div class="glass-card border border-pastel-lavender shadow-pastel p-3.5 sm:p-4 flex flex-col gap-2.5 select-none">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <i data-lucide="layers" class="w-4 h-4 text-purple-600"></i>
            <h3 class="font-cute font-bold text-sm text-inkslate">Timeline 3-Jalur Terintegrasi</h3>
          </div>
          <span class="text-[11px] text-slate-500">Klik atau geser untuk scrubbing</span>
        </div>

        <div class="overflow-x-auto pb-1">
          <div id="timelineWrapper" class="relative min-w-[460px] rounded-[20px] bg-pastel-lavenderLight/55 border border-pastel-lavender p-2.5 space-y-2 cursor-pointer">
            
            <!-- Time Ruler -->
            <div id="timelineRuler" class="relative h-5 border-b border-pastel-lavender flex items-center text-[10px] font-mono text-slate-500"></div>

            <!-- Playhead Needle -->
            <div
              id="timelinePlayhead"

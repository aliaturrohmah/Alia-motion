    // 9. 60FPS PLAYBACK LOOP & SCENE VOICEOVER TRIGGERING
    // -------------------------------------------------------------------------
    function animationLoop(timestamp) {
      if (state.playback.isPlaying && !state.exportSettings.isExporting) {
        if (state.playback.lastFrameTs === null) {
          state.playback.lastFrameTs = timestamp;
        }
        const deltaSec = Math.min(0.1, (timestamp - state.playback.lastFrameTs) / 1000);
        state.playback.lastFrameTs = timestamp;
        state.playback.currentTime += deltaSec;

        const totalDur = getTotalDuration();
        if (state.playback.currentTime >= totalDur) {
          if (state.playback.isLooping) {
            state.playback.currentTime = 0;
            state.playback.lastSpokenSceneId = null;
          } else {
            state.playback.currentTime = 0;
            pausePlayback();
          }
        }

        const currentSceneInfo = getSceneAtTime(state.playback.currentTime);
        if (currentSceneInfo.scene && state.playback.lastSpokenSceneId !== currentSceneInfo.scene.id) {
          state.playback.lastSpokenSceneId = currentSceneInfo.scene.id;
          if (state.selectedSceneIndex !== currentSceneInfo.index) {
            state.selectedSceneIndex = currentSceneInfo.index;
            syncEditorFieldsFromSelectedScene();
            renderSceneListUI();
          }
          speakSceneNatural(currentSceneInfo.scene);
        }
      } else {
        state.playback.lastFrameTs = null;
      }

      renderPreviewFrame();
      updatePlaybackHUD();
      requestAnimationFrame(animationLoop);
    }

    function startPlayback() {
      bgmEngine.unlock();
      if (state.playback.currentTime >= getTotalDuration() - 0.05) {
        state.playback.currentTime = 0;
      }
      state.playback.isPlaying = true;
      state.playback.lastFrameTs = null;
      state.playback.lastSpokenSceneId = null;
      bgmEngine.start();
      updatePlayPauseButtonUI();
    }

    function pausePlayback() {
      state.playback.isPlaying = false;
      state.playback.lastFrameTs = null;
      stopNaturalSpeech();

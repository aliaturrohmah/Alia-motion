    // -------------------------------------------------------------------------
    // 5. WEB AUDIO AMBIENT BGM SYNTHESIZER WITH 20% AUTO-DUCKING
    // -------------------------------------------------------------------------
    class PastelAmbientAudioEngine {
      constructor() {
        this.ctx = null;
        this.bgmGain = null;
        this.voiceGain = null;
        this.masterGain = null;
        this.analyser = null;
        this.isRunning = false;
        this.isDucked = false;
        this.stepTimer = null;
        this.stepIndex = 0;
        this.rainNode = null;
        this.activeBufferSource = null;
      }

      init() {
        if (this.ctx) return;
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        if (!AudioCtx) return;

        this.ctx = new AudioCtx();
        this.masterGain = this.ctx.createGain();
        this.masterGain.gain.value = 1.0;

        this.bgmGain = this.ctx.createGain();
        this.bgmGain.gain.value = state.voice.bgmVolume * 0.35;

        this.voiceGain = this.ctx.createGain();
        this.voiceGain.gain.value = state.voice.volume;

        this.analyser = this.ctx.createAnalyser();
        this.analyser.fftSize = 64;

        this.bgmGain.connect(this.masterGain);
        this.voiceGain.connect(this.masterGain);
        this.masterGain.connect(this.analyser);
        this.analyser.connect(this.ctx.destination);
      }

      unlock() {
        this.init();
        if (this.ctx && this.ctx.state === 'suspended') {
          this.ctx.resume().catch(() => {});
        }
      }

      setVolume(vol) {
        if (!this.bgmGain || !this.ctx) return;
        const duckMultiplier = this.isDucked ? 0.20 : 1.0;
        this.bgmGain.gain.setTargetAtTime(vol * 0.35 * duckMultiplier, this.ctx.currentTime, 0.14);
      }

      setDucking(duck) {
        this.isDucked = duck;
        if (!this.bgmGain || !this.ctx) return;
        const duckMultiplier = duck ? 0.20 : 1.0;
        this.bgmGain.gain.setTargetAtTime(
          state.voice.bgmVolume * 0.35 * duckMultiplier,
          this.ctx.currentTime,
          duck ? 0.12 : 0.28
        );
      }

      playBuffer(audioBuffer, volume = 0.95, onEnded = null) {
        this.unlock();
        if (!this.ctx || !audioBuffer) return;
        this.stopVoiceBuffer();
        const src = this.ctx.createBufferSource();
        src.buffer = audioBuffer;
        this.voiceGain.gain.value = volume;
        src.connect(this.voiceGain);
        src.onended = () => {
          this.activeBufferSource = null;
          if (onEnded) onEnded();
        };
        src.start();
        this.activeBufferSource = src;
      }

      stopVoiceBuffer() {
        if (this.activeBufferSource) {
          try { this.activeBufferSource.stop(); } catch (e) {}
          this.activeBufferSource = null;
        }
      }

      start() {
        if (state.voice.bgmType === 'none') return;
        this.unlock();
        if (!this.ctx) return;
        if (this.isRunning) return;

        this.isRunning = true;
        this.setVolume(state.voice.bgmVolume);

        if (state.voice.bgmType === 'rain-piano') {
          this.startSoftRainNoise();
        }

        this.scheduleChordStep();
        this.stepTimer = setInterval(() => this.scheduleChordStep(), 2200);
      }

      stop() {
        this.isRunning = false;
        if (this.stepTimer) {
          clearInterval(this.stepTimer);
          this.stepTimer = null;
        }
        if (this.rainNode) {
          try { this.rainNode.stop(); } catch (e) {}
          this.rainNode = null;
        }
        if (this.activeBufferSource) {
          try { this.activeBufferSource.stop(); } catch (e) {}
          this.activeBufferSource = null;
        }
      }

      startSoftRainNoise() {
        if (!this.ctx || this.rainNode) return;
        const bufferSize = this.ctx.sampleRate * 2;
        const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
        const data = buffer.getChannelData(0);
        let b0 = 0, b1 = 0, b2 = 0;
        for (let i = 0; i < bufferSize; i++) {
          const white = Math.random() * 2 - 1;
          b0 = 0.99765 * b0 + white * 0.0990460;
          b1 = 0.96300 * b1 + white * 0.2965164;
          b2 = 0.57000 * b2 + white * 1.0526913;
          data[i] = (b0 + b1 + b2 + white * 0.1848) * 0.045;
        }

        const noise = this.ctx.createBufferSource();
        noise.buffer = buffer;
        noise.loop = true;

        const filter = this.ctx.createBiquadFilter();
        filter.type = 'lowpass';
        filter.frequency.value = 920;

        noise.connect(filter);
        filter.connect(this.bgmGain);
        noise.start();
        this.rainNode = noise;
      }

      scheduleChordStep() {
        if (!this.isRunning || !this.ctx || state.voice.bgmType === 'none') return;
        const now = this.ctx.currentTime;

        const progressions = {
          'lofi-pastel': [
            [174.61, 220.00, 261.63, 329.63],
            [164.81, 196.00, 246.94, 293.66],
            [146.83, 174.61, 220.00, 261.63],
            [130.81, 196.00, 246.94, 329.63]
          ],
          'music-box': [
            [523.25, 659.25, 783.99],
            [493.88, 587.33, 783.99],
            [440.00, 523.25, 659.25],
            [392.00, 493.88, 659.25]
          ],
          'rain-piano': [
            [261.63, 329.63, 392.00],
            [220.00, 261.63, 329.63],
            [174.61, 220.00, 349.23],
            [196.00, 246.94, 392.00]
          ]
        };

        const chords = progressions[state.voice.bgmType] || progressions['lofi-pastel'];
        const chord = chords[this.stepIndex % chords.length];
        this.stepIndex++;

        chord.forEach((freq, idx) => {
          const osc = this.ctx.createOscillator();
          const noteGain = this.ctx.createGain();
          const filter = this.ctx.createBiquadFilter();

          osc.type = state.voice.bgmType === 'music-box' ? 'sine' : 'triangle';
          const delayOffset = state.voice.bgmType === 'music-box' ? idx * 0.34 : idx * 0.05;
          osc.frequency.setValueAtTime(freq, now + delayOffset);

          filter.type = 'lowpass';
          filter.frequency.setValueAtTime(state.voice.bgmType === 'music-box' ? 2400 : 880, now + delayOffset);

          noteGain.gain.setValueAtTime(0.0001, now + delayOffset);
          noteGain.gain.linearRampToValueAtTime(0.15 / chord.length, now + delayOffset + 0.18);
          noteGain.gain.exponentialRampToValueAtTime(0.0001, now + delayOffset + 2.1);

          osc.connect(filter);
          filter.connect(noteGain);
          noteGain.connect(this.bgmGain);

          osc.start(now + delayOffset);
          osc.stop(now + delayOffset + 2.2);
        });
      }

      getVisualizerLevels() {
        const speaking = ('speechSynthesis' in window) && window.speechSynthesis.speaking;
        if (!this.analyser || !this.isRunning) {
          if (speaking || state.playback.isPlaying) {
            const t = performance.now() * 0.009;
            return [0, 1, 2, 3, 4, 5].map(i => 0.25 + 0.58 * Math.abs(Math.sin(t + i * 0.85)));
          }
          return [0.16, 0.22, 0.18, 0.26, 0.16, 0.22];
        }
        const arr = new Uint8Array(this.analyser.frequencyBinCount);
        this.analyser.getByteFrequencyData(arr);
        return [1, 3, 5, 7, 9, 11].map(idx => {
          const base = Math.max(0.18, (arr[idx] || 20) / 170);
          return speaking ? Math.min(1, base + 0.32 * Math.abs(Math.sin(performance.now() * 0.012 + idx))) : base;
        });
      }
    }


        if (statusText) statusText.childNodes[statusText.childNodes.length - 1].textContent = ' Merekam suara asli...';
        if (dotEl) dotEl.className = 'w-2 h-2 rounded-full bg-rose-500 animate-ping';

        const sourceNode = bgmEngine.ctx.createMediaStreamSource(stream);
        const meterAnalyser = bgmEngine.ctx.createAnalyser();
        meterAnalyser.fftSize = 256;
        sourceNode.connect(meterAnalyser);
        const meterData = new Uint8Array(meterAnalyser.frequencyBinCount);

        micAnalyserTimer = setInterval(() => {
          meterAnalyser.getByteTimeDomainData(meterData);
          let sum = 0;
          for (let i = 0; i < meterData.length; i++) {
            const norm = (meterData[i] - 128) / 128;
            sum += norm * norm;
          }
          const rms = Math.sqrt(sum / meterData.length);
          const pct = Math.min(100, Math.max(6, Math.round(rms * 380)));
          if (meterBar) meterBar.style.width = `${pct}%`;

          const elapsedSec = (performance.now() - micRecordStartTs) / 1000;
          if (timerEl) timerEl.textContent = formatTimecode(elapsedSec);
        }, 60);

        const chunks = [];
        const recorder = new MediaRecorder(stream);
        activeMediaRecorder = recorder;

        recorder.ondataavailable = (e) => {
          if (e.data && e.data.size > 0) chunks.push(e.data);
        };

        recorder.onstop = async () => {
          clearInterval(micAnalyserTimer);
          stream.getTracks().forEach(t => t.stop());
          activeMicStream = null;
          activeMediaRecorder = null;
          state.voice.isRecordingMic = false;

          if (btnLabel) btnLabel.textContent = 'Rekam Ulang';
          if (dotEl) dotEl.className = 'w-2 h-2 rounded-full bg-emerald-500';
          if (meterBar) meterBar.style.width = '4%';
          if (statusText) statusText.childNodes[statusText.childNodes.length - 1].textContent = ' Memoles Studio Mastering DSP...';

          const rawBlob = new Blob(chunks, { type: recorder.mimeType || 'audio/webm' });
          const arrayBuf = await rawBlob.arrayBuffer();
          const decoded = await bgmEngine.ctx.decodeAudioData(arrayBuf);
          const mastered = await applyStudioPodcastMastering(decoded);

          sc.audioBuffer = mastered;
          sc.audioSourceType = 'human';
          if (state.voice.syncNarration && mastered) {
            sc.duration = Math.max(2.5, Math.round((mastered.duration + 0.45) * 2) / 2);
          }

          if (statusText) statusText.childNodes[statusText.childNodes.length - 1].textContent = ' Rekaman selesai & dimastering!';
          syncEditorFieldsFromSelectedScene();
          renderSceneListUI();
          rebuildSubtitlesFromVoice();
          showToast('🎙️ Suara asli berhasil direkam & dipoles Studio DSP!', 'success');
        };

        recorder.start(100);
      } catch (err) {
        state.voice.isRecordingMic = false;
        showToast('Izin mikrofon ditolak atau tidak tersedia.', 'warn');

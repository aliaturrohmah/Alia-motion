    // -------------------------------------------------------------------------
    // 4. NATURAL SULIH SUARA ENGINE (DISCOVERY, SANITIZER, PROSODY & BREATHING)
    // -------------------------------------------------------------------------
    function angkaKeKata(n) {
      n = Math.floor(Math.abs(Number(n) || 0));
      if (n === 0) return 'nol';
      const satuan = ['', 'satu', 'dua', 'tiga', 'empat', 'lima', 'enam', 'tujuh', 'delapan', 'sembilan', 'sepuluh', 'sebelas'];
      if (n < 12) return satuan[n];
      if (n < 20) return satuan[n - 10] + ' belas';
      if (n < 100) return satuan[Math.floor(n / 10)] + ' puluh' + (n % 10 ? ' ' + angkaKeKata(n % 10) : '');
      if (n < 200) return 'seratus' + (n % 100 ? ' ' + angkaKeKata(n % 100) : '');
      if (n < 1000) return satuan[Math.floor(n / 100)] + ' ratus' + (n % 100 ? ' ' + angkaKeKata(n % 100) : '');
      if (n < 2000) return 'seribu' + (n % 1000 ? ' ' + angkaKeKata(n % 1000) : '');
      if (n < 1000000) return angkaKeKata(Math.floor(n / 1000)) + ' ribu' + (n % 1000 ? ' ' + angkaKeKata(n % 1000) : '');
      if (n < 1000000000) return angkaKeKata(Math.floor(n / 1000000)) + ' juta' + (n % 1000000 ? ' ' + angkaKeKata(n % 1000000) : '');
      return String(n);
    }

    function sanitizeTextForIndonesianSpeech(rawText) {
      if (!rawText) return '';
      let text = String(rawText);

      try {
        text = text.replace(/[\p{Extended_Pictographic}\u{1F3FB}-\u{1F3FF}\u{1F9B0}-\u{1F9B3}\uFE0F\u200D]/gu, '');
      } catch (e) {
        text = text.replace(/[\uD800-\uDBFF][\uDC00-\uDFFF]/g, '');
      }

      text = text.replace(/Rp\.?\s*([\d.]+)(?:,(\d+))?/gi, (_, intPart, decPart) => {
        const cleanInt = parseInt(intPart.replace(/\./g, ''), 10);
        if (isNaN(cleanInt)) return 'rupiah';
        let spoken = angkaKeKata(cleanInt) + ' rupiah';
        if (decPart && parseInt(decPart, 10) > 0) {
          spoken += ' ' + angkaKeKata(parseInt(decPart, 10)) + ' sen';
        }
        return spoken;
      });

      text = text.replace(/(\d+)(?:[.,](\d+))?\s*%/g, (_, intPart, decPart) => {
        let spoken = angkaKeKata(parseInt(intPart, 10));
        if (decPart) {
          spoken += ' koma ' + decPart.split('').map(d => angkaKeKata(parseInt(d, 10))).join(' ');
        }
        return spoken + ' persen';
      });

      text = text
        .replace(/\s*&\s*/g, ' dan ')
        .replace(/\s*\/\s*/g, ' atau ')
        .replace(/\s*\+\s*/g, ' tambah ')
        .replace(/\s*=\s*/g, ' sama dengan ');

      text = text.replace(/\b\d{1,3}(?:\.\d{3})+\b/g, (m) => {
        const num = parseInt(m.replace(/\./g, ''), 10);
        return isNaN(num) ? m : angkaKeKata(num);
      });
      text = text.replace(/\b\d+\b/g, (m) => {
        const num = parseInt(m, 10);
        return num <= 999999999 ? angkaKeKata(num) : m;
      });

      return text.replace(/\s+/g, ' ').trim();
    }

    function stripProsodyTagsForSubtitle(text) {
      return String(text || '')
        .replace(/\[(napas|jeda|lembut|senyum)\]/gi, ' ')
        .replace(/\s+/g, ' ')
        .trim();
    }

    function naturalizeIndonesianScript(rawText) {
      let text = String(rawText || '').trim();
      if (!text) return '';

      const replacements = [
        [/\btidak\b/gi, 'nggak'],
        [/\bsangat\b/gi, 'bener-bener'],
        [/\bnamun\b/gi, '[jeda] tapi'],
        [/\bole karena itu\b/gi, '[napas] makanya'],
        [/\bsehingga\b/gi, '[jeda] sampai akhirnya'],
        [/\bapabila\b/gi, 'kalau'],
        [/\bketika\b/gi, '[jeda] waktu'],
        [/\bkarena\b/gi, '[jeda] karena'],
        [/\bdengan demikian\b/gi, '[napas] jadi']
      ];

      replacements.forEach(([pattern, rep]) => {
        text = text.replace(pattern, rep);
      });

      if (!/^\[(napas|lembut|senyum)/i.test(text)) {
        text = `[napas] ${text}`;
      }

      text = text.replace(/([.!?])\s+(?!\[)(?=[A-Za-z0-9])/g, '$1 [napas] ');

      return text
        .replace(/(\[(?:napas|jeda|lembut|senyum)\]\s*){2,}/gi, '$1')
        .replace(/\s+/g, ' ')
        .trim();
    }

    function splitTextIntoProsodyClauses(rawText, basePitch = 1.0, baseRate = 0.96) {
      if (!rawText) return [];

      const tokens = String(rawText).split(/(\[(?:napas|jeda|lembut|senyum)\])/gi).filter(Boolean);
      const resultClauses = [];

      let pendingBreath = false;
      let pendingPauseMs = 0;
      let activeTone = 'normal';

      tokens.forEach((tok) => {
        const lowerTok = tok.trim().toLowerCase();
        if (lowerTok === '[napas]') {
          pendingBreath = true;
          pendingPauseMs = Math.max(pendingPauseMs, 340);
          return;
        }
        if (lowerTok === '[jeda]') {
          pendingPauseMs = Math.max(pendingPauseMs, 260);
          return;
        }
        if (lowerTok === '[lembut]') {
          activeTone = 'lembut';
          return;
        }
        if (lowerTok === '[senyum]') {
          activeTone = 'senyum';
          return;
        }

        const sanitized = sanitizeTextForIndonesianSpeech(tok);
        if (!sanitized) return;

        const withConjunctionPauses = sanitized.replace(
          /\s+\b(dan|karena|tapi|lalu|ketika|namun|seperti)\b\s+/gi,
          ', $1 '
        );

        const rawClauses = withConjunctionPauses.match(/[^,;:—.!?]+(?:\.{3}|[,;:—.!?]+|$)/g) || [withConjunctionPauses];

        rawClauses
          .map(c => c.trim())
          .filter(Boolean)
          .forEach((clause) => {
            let pauseMs = 200;
            let pitchContour = basePitch;
            let rateContour = baseRate;

            if (activeTone === 'lembut') {
              pitchContour -= 0.02;
              rateContour *= 0.93;
            } else if (activeTone === 'senyum') {
              pitchContour += 0.035;
              rateContour *= 1.02;
            }

            if (/\.{3}$/.test(clause) || /…$/.test(clause)) {
              pauseMs = 460;
              pitchContour = Math.max(0.75, pitchContour - 0.02);
              rateContour = Math.max(0.75, rateContour * 0.95);
            } else if (/\?$/.test(clause)) {
              pauseMs = 390;
              pitchContour = Math.min(1.38, pitchContour + 0.045);
            } else if (/!$/.test(clause)) {
              pauseMs = 360;
              pitchContour = Math.min(1.38, pitchContour + 0.03);
            } else if (/\.$/.test(clause)) {
              pauseMs = 380;
              pitchContour = Math.max(0.75, pitchContour - 0.025);
            } else if (/[,;:—]$/.test(clause)) {
              pauseMs = 175;
              pitchContour += 0.01;
            }

            const speakableText = clause.replace(/[,;:—.!?…]+$/g, '').trim();
            if (!speakableText) return;

            resultClauses.push({
              displayClause: clause,
              speakableText,
              breathBefore: pendingBreath,
              prePauseMs: pendingPauseMs,
              pauseMs,
              pitch: Number(Math.min(1.4, Math.max(0.75, pitchContour)).toFixed(3)),
              rate: Number(Math.min(1.35, Math.max(0.75, rateContour)).toFixed(3))
            });

            pendingBreath = false;
            pendingPauseMs = 0;
          });
      });

      if (resultClauses.length > 0) {
        resultClauses[resultClauses.length - 1].pauseMs = 80;
      }

      return resultClauses;
    }

    // -------------------------------------------------------------------------
    // 4B. STUDIO PODCAST MASTERING DSP & SPEECH ENVELOPE ANALYZER
    // -------------------------------------------------------------------------
    function trimSilenceFromBuffer(audioBuffer, threshold = 0.012) {
      if (!audioBuffer) return audioBuffer;
      const sr = audioBuffer.sampleRate;
      const ch0 = audioBuffer.getChannelData(0);
      const len = ch0.length;

      let startSample = 0;
      let endSample = len - 1;

      while (startSample < len && Math.abs(ch0[startSample]) < threshold) {
        startSample++;
      }
      while (endSample > startSample && Math.abs(ch0[endSample]) < threshold) {
        endSample--;
      }

      if (endSample <= startSample + sr * 0.15) {
        return audioBuffer;
      }

      const padSamples = Math.floor(sr * 0.09);
      const trimmedStart = Math.max(0, startSample - padSamples);
      const trimmedEnd = Math.min(len, endSample + padSamples);
      const newLen = Math.max(1, trimmedEnd - trimmedStart);

      const numCh = audioBuffer.numberOfChannels;
      const out = new AudioBuffer({ length: newLen, numberOfChannels: numCh, sampleRate: sr });
      for (let c = 0; c < numCh; c++) {
        out.getChannelData(c).set(audioBuffer.getChannelData(c).subarray(trimmedStart, trimmedEnd));
      }
      return out;
    }

    async function applyStudioPodcastMastering(rawBuffer) {
      if (!rawBuffer) return null;
      const trimmed = trimSilenceFromBuffer(rawBuffer);
      const sr = 44100;
      const outLen = Math.max(Math.ceil(sr * 0.2), Math.ceil(trimmed.duration * sr));
      const offline = new OfflineAudioContext(2, outLen, sr);

      const src = offline.createBufferSource();
      src.buffer = trimmed;

      const hpFilter = offline.createBiquadFilter();
      hpFilter.type = 'highpass';
      hpFilter.frequency.value = 85;
      hpFilter.Q.value = 0.7;

      const chestEq = offline.createBiquadFilter();
      chestEq.type = 'peaking';
      chestEq.frequency.value = 210;
      chestEq.Q.value = 1.1;
      chestEq.gain.value = 2.8;

      const notchEq = offline.createBiquadFilter();
      notchEq.type = 'peaking';
      notchEq.frequency.value = 3400;
      notchEq.Q.value = 2.4;
      notchEq.gain.value = -3.2;

      const airShelf = offline.createBiquadFilter();
      airShelf.type = 'highshelf';
      airShelf.frequency.value = 8500;
      airShelf.gain.value = 2.5;

      const comp = offline.createDynamicsCompressor();
      comp.threshold.value = -20;
      comp.knee.value = 14;
      comp.ratio.value = 3.2;
      comp.attack.value = 0.008;
      comp.release.value = 0.18;

      const boothDelay = offline.createDelay(0.1);
      boothDelay.delayTime.value = 0.018;
      const boothFilter = offline.createBiquadFilter();
      boothFilter.type = 'lowpass';
      boothFilter.frequency.value = 2800;
      const boothGain = offline.createGain();
      boothGain.gain.value = 0.06;

      const masterOut = offline.createGain();
      masterOut.gain.value = 1.15;

      src.connect(hpFilter);
      hpFilter.connect(chestEq);
      chestEq.connect(notchEq);
      notchEq.connect(airShelf);
      airShelf.connect(comp);

      comp.connect(masterOut);
      comp.connect(boothDelay);
      boothDelay.connect(boothFilter);
      boothFilter.connect(boothGain);
      boothGain.connect(masterOut);

      masterOut.connect(offline.destination);

      src.start(0);
      return await offline.startRendering();
    }

    function analyzeSpeechEnvelope(audioBuffer, rawNarrationText, sceneStartTime) {
      const cleanText = stripProsodyTagsForSubtitle(rawNarrationText);
      if (!audioBuffer || !cleanText) return null;

      const sr = audioBuffer.sampleRate;
      const data = audioBuffer.getChannelData(0);
      const frameSize = Math.floor(sr * 0.025);
      const totalFrames = Math.max(1, Math.floor(data.length / frameSize));
      const rmsFrames = new Float32Array(totalFrames);

      let maxRms = 0.0001;
      for (let f = 0; f < totalFrames; f++) {
        let sumSq = 0;
        const start = f * frameSize;
        const end = Math.min(data.length, start + frameSize);
        for (let i = start; i < end; i++) {
          sumSq += data[i] * data[i];
        }
        const rms = Math.sqrt(sumSq / Math.max(1, end - start));
        rmsFrames[f] = rms;
        if (rms > maxRms) maxRms = rms;
      }

      const activeThreshold = maxRms * 0.14;
      let firstActiveFrame = 0;
      let lastActiveFrame = totalFrames - 1;

      while (firstActiveFrame < totalFrames && rmsFrames[firstActiveFrame] < activeThreshold) {
        firstActiveFrame++;
      }
      while (lastActiveFrame > firstActiveFrame && rmsFrames[lastActiveFrame] < activeThreshold) {
        lastActiveFrame--;
      }

      const speechStartOffset = (firstActiveFrame * frameSize) / sr;
      const speechEndOffset = Math.min(audioBuffer.duration, ((lastActiveFrame + 1) * frameSize) / sr);
      const activeSpeechDur = Math.max(0.4, speechEndOffset - speechStartOffset);

      const activeSlice = rmsFrames.slice(firstActiveFrame, lastActiveFrame + 1);
      const cumulativeEnergy = new Float32Array(activeSlice.length + 1);
      let totalEnergy = 0;
      for (let i = 0; i < activeSlice.length; i++) {
        const w = Math.max(0.05, activeSlice[i] / maxRms);
        totalEnergy += w;
        cumulativeEnergy[i + 1] = totalEnergy;
      }

      const mapEnergyRatioToTime = (ratio) => {
        const targetE = Math.min(1, Math.max(0, ratio)) * totalEnergy;
        let idx = 0;
        while (idx < activeSlice.length && cumulativeEnergy[idx + 1] < targetE) {
          idx++;
        }
        const frac = activeSlice.length > 0 ? idx / activeSlice.length : ratio;
        return sceneStartTime + speechStartOffset + frac * activeSpeechDur;
      };

      return {
        speechStartOffset,
        speechEndOffset,
        activeSpeechDur,
        mapEnergyRatioToTime
      };
    }

    function computeWaveformPeaks(audioBuffer, barCount = 24) {
      if (!audioBuffer) return null;
      const ch = audioBuffer.getChannelData(0);
      const blockSize = Math.max(1, Math.floor(ch.length / barCount));
      const peaks = [];
      let globalMax = 0.01;

      for (let b = 0; b < barCount; b++) {
        let peak = 0;
        const start = b * blockSize;
        const end = Math.min(ch.length, start + blockSize);
        for (let i = start; i < end; i += 4) {
          const v = Math.abs(ch[i]);
          if (v > peak) peak = v;
        }
        peaks.push(peak);
        if (peak > globalMax) globalMax = peak;
      }
      return peaks.map(p => Math.min(96, Math.max(16, Math.round((p / globalMax) * 92))));
    }


    function detectPaletteFromPrompt(prompt, override, fallback = 'sunset-sakura') {
      if (override === 'moon') return 'starry-lavender';
      if (override === 'ocean') return 'morning-mint';
      if (override === 'coffee') return 'peach-dream';

      const p = (prompt || '').toLowerCase();
      if (p.includes('hujan') || p.includes('rain') || p.includes('lo-fi')) return 'rainy-lofi';
      if (p.includes('malam') || p.includes('bintang') || p.includes('bulan') || p.includes('night')) return 'starry-lavender';
      if (p.includes('pagi') || p.includes('laut') || p.includes('ombak') || p.includes('pantai')) return 'morning-mint';
      if (p.includes('kopi') || p.includes('kafe') || p.includes('hangat')) return 'peach-dream';
      if (p.includes('senja') || p.includes('sakura')) return 'sunset-sakura';
      return fallback;
    }

    function resizePreviewCanvas() {
      const container = document.getElementById('canvasStageContainer');
      if (!container) return;

      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const maxW = Math.max(240, container.clientWidth - 24);
      const maxH = 405;
      const ratioCfg = PLATFORM_RATIOS[state.aspectRatio] || PLATFORM_RATIOS['16:9'];
      const r = ratioCfg.ratioNum;

      let targetW = maxW;
      let targetH = targetW / r;

      if (targetH > maxH) {
        targetH = maxH;
        targetW = targetH * r;
      }

      previewCanvas.style.width = `${Math.round(targetW)}px`;
      previewCanvas.style.height = `${Math.round(targetH)}px`;
      previewCanvas.width = Math.round(targetW * dpr);
      previewCanvas.height = Math.round(targetH * dpr);
      previewCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function renderSceneLayerToCtx(targetCtx, scene, localTime, duration, w, h, alpha = 1, extraScale = 1, offsetX = 0) {
      if (!scene) return;
      targetCtx.save();
      targetCtx.globalAlpha = alpha;

      const progress = Math.min(1, Math.max(0, localTime / Math.max(0.1, duration)));
      const paletteKey = detectPaletteFromPrompt(scene.prompt, scene.illustrationOverride, scene.paletteSeed || 'sunset-sakura');
      const pal = PALETTES[paletteKey] || PALETTES['sunset-sakura'];
      const style = state.artStyle;

      let camScale = extraScale;
      let camX = offsetX;
      let camY = 0;

      switch (scene.cameraMotion) {
        case 'zoom-in':
          camScale *= 1 + progress * 0.12;
          break;
        case 'pan-right':
          camScale *= 1.1;
          camX += (0.5 - progress) * (w * 0.08);
          break;
        case 'floating-drift':
          camScale *= 1.05;
          camX += Math.sin(localTime * 1.1) * (w * 0.015);
          camY += Math.cos(localTime * 0.9) * (h * 0.015);
          break;
        case 'parallax-sway':
          camScale *= 1.06;
          camX += Math.sin(localTime * 1.4) * (w * 0.02);
          break;
        default:
          camScale *= 1.02;
          break;
      }

      targetCtx.translate(w / 2 + camX, h / 2 + camY);
      targetCtx.scale(camScale, camScale);
      targetCtx.translate(-w / 2, -h / 2);

      // 1. Pastel Sky Gradient
      const skyGrad = targetCtx.createLinearGradient(0, 0, 0, h);
      skyGrad.addColorStop(0, pal.skyTop);
      skyGrad.addColorStop(0.55, pal.skyMid);
      skyGrad.addColorStop(1, pal.skyBottom);
      targetCtx.fillStyle = skyGrad;
      targetCtx.fillRect(-40, -40, w + 80, h + 80);

      // Retro Vaporwave Horizon Grid
      if (style === 'retro-vaporwave') {
        targetCtx.save();
        targetCtx.strokeStyle = 'rgba(255, 255, 255, 0.24)';
        targetCtx.lineWidth = Math.max(1, w / 640);
        const horizonY = h * 0.68;
        for (let i = -6; i <= 6; i++) {
          targetCtx.beginPath();
          targetCtx.moveTo(w / 2 + i * (w * 0.04), horizonY);
          targetCtx.lineTo(w / 2 + i * (w * 0.18), h);
          targetCtx.stroke();
        }
        for (let r = 1; r <= 5; r++) {
          const yLine = horizonY + Math.pow(r / 5, 1.6) * (h - horizonY);
          targetCtx.beginPath();
          targetCtx.moveTo(0, yLine);
          targetCtx.lineTo(w, yLine);
          targetCtx.stroke();
        }
        targetCtx.restore();
      }

      // 2. Celestial Sun or Crescent Moon
      const isNight = paletteKey === 'starry-lavender' || paletteKey === 'rainy-lofi' || scene.illustrationOverride === 'moon';
      const sunX = w * 0.72 + Math.sin(localTime * 0.25) * (w * 0.012);
      const sunY = h * 0.25 + Math.cos(localTime * 0.3) * (h * 0.012);
      const sunRadius = Math.min(w, h) * 0.11;

      const glowGrad = targetCtx.createRadialGradient(sunX, sunY, sunRadius * 0.2, sunX, sunY, sunRadius * 2.8);
      glowGrad.addColorStop(0, pal.sunGlow);
      glowGrad.addColorStop(1, 'rgba(255,255,255,0)');
      targetCtx.fillStyle = glowGrad;
      targetCtx.beginPath();
      targetCtx.arc(sunX, sunY, sunRadius * 2.8, 0, Math.PI * 2);
      targetCtx.fill();

      targetCtx.fillStyle = pal.sunColor;
      targetCtx.beginPath();
      targetCtx.arc(sunX, sunY, sunRadius, 0, Math.PI * 2);
      targetCtx.fill();

      if (isNight) {
        targetCtx.fillStyle = pal.skyTop;
        targetCtx.beginPath();
        targetCtx.arc(sunX - sunRadius * 0.35, sunY - sunRadius * 0.18, sunRadius * 0.85, 0, Math.PI * 2);
        targetCtx.fill();
      }

      // 3. Drifting Clouds
      drawCloudsToCtx(targetCtx, w, h, localTime, style);

      // 4. Hills or Ocean Waves
      const override = scene.illustrationOverride || 'auto';
      const promptLower = (scene.prompt || '').toLowerCase();
      const showOcean = override === 'ocean' || (override === 'auto' && (promptLower.includes('laut') || promptLower.includes('ombak') || promptLower.includes('pantai')));

      if (showOcean) {
        drawOceanToCtx(targetCtx, w, h, localTime, pal);
      } else {
        drawHillsToCtx(targetCtx, w, h, localTime, pal, style);
      }

      // 5. Keyword-Reactive & Override Vector Illustrations
      if (override !== 'none') {
        drawIllustrationsToCtx(targetCtx, promptLower, override, w, h, localTime);
      }

      // 6. Watercolor Soft Light Wash
      if (style === 'dreamy-watercolor') {
        targetCtx.save();
        targetCtx.globalCompositeOperation = 'soft-light';
        const wash = targetCtx.createRadialGradient(w * 0.3, h * 0.3, 10, w * 0.5, h * 0.5, w * 0.7);
        wash.addColorStop(0, 'rgba(255,255,255,0.65)');
        wash.addColorStop(1, 'rgba(233,216,253,0.3)');
        targetCtx.fillStyle = wash;
        targetCtx.fillRect(0, 0, w, h);
        targetCtx.restore();
      }

      // 7. Atmospheric Particles
      drawParticlesToCtx(targetCtx, scene.particles, w, h, localTime);

      targetCtx.restore();
    }

    function drawCloudsToCtx(c, w, h, t, style) {
      const clouds = [
        { baseX: 0.18, y: 0.22, scale: 1.0, speed: w * 0.01 },
        { baseX: 0.52, y: 0.16, scale: 0.8, speed: w * 0.007 },
        { baseX: 0.85, y: 0.32, scale: 0.9, speed: w * 0.0085 }
      ];

      clouds.forEach((cl) => {
        const span = w + w * 0.25;
        const cx = ((cl.baseX * w + t * cl.speed) % span) - w * 0.12;
        const cy = cl.y * h;
        const r = Math.min(w, h) * 0.065 * cl.scale;

        c.save();
        c.fillStyle = style === 'soft-clay' ? 'rgba(255,255,255,0.9)' : 'rgba(255,255,255,0.7)';
        if (style === 'soft-clay') {
          c.shadowColor = 'rgba(159, 122, 234, 0.2)';
          c.shadowBlur = r * 0.4;
          c.shadowOffsetY = r * 0.16;
        }
        c.beginPath();
        c.arc(cx, cy, r, 0, Math.PI * 2);
        c.arc(cx + r * 0.85, cy - r * 0.15, r * 0.8, 0, Math.PI * 2);
        c.arc(cx + r * 1.6, cy + r * 0.05, r * 0.65, 0, Math.PI * 2);
        c.arc(cx - r * 0.75, cy + r * 0.1, r * 0.65, 0, Math.PI * 2);
        c.fill();
        c.restore();
      });
    }

    function drawHillsToCtx(c, w, h, t, pal, style) {
      const layers = [
        { yBase: 0.64, amp: h * 0.06, freq: 3.8 / w, shift: t * 0.15, color: pal.hillBack },
        { yBase: 0.74, amp: h * 0.05, freq: 5.0 / w, shift: -t * 0.22, color: pal.hillMid },
        { yBase: 0.84, amp: h * 0.035, freq: 6.2 / w, shift: t * 0.3, color: pal.hillFront }
      ];

      layers.forEach((layer) => {
        c.save();
        c.fillStyle = layer.color;
        if (style === 'soft-clay') {
          c.shadowColor = 'rgba(45, 55, 72, 0.16)';
          c.shadowBlur = h * 0.035;
          c.shadowOffsetY = -h * 0.01;
        }
        c.beginPath();
        c.moveTo(-20, h + 20);
        const step = Math.max(8, w / 60);
        for (let x = -20; x <= w + 20; x += step) {
          const y = layer.yBase * h + Math.sin(x * layer.freq + layer.shift) * layer.amp;
          c.lineTo(x, y);
        }
        c.lineTo(w + 20, h + 20);
        c.closePath();
        c.fill();
        c.restore();
      });
    }

    function drawOceanToCtx(c, w, h, t, pal) {
      c.fillStyle = pal.hillBack;
      c.fillRect(0, h * 0.62, w, h * 0.38);

      const step = Math.max(8, w / 64);
      for (let row = 0; row < 4; row++) {
        const yBase = h * (0.65 + row * 0.085);
        c.fillStyle = row % 2 === 0 ? pal.hillMid : pal.hillFront;
        c.beginPath();
        c.moveTo(0, h);
        for (let x = 0; x <= w + step; x += step) {
          const waveY = yBase + Math.sin((x / w) * 12 + t * (1.8 + row * 0.3) + row) * (h * 0.016 + row * 2);
          c.lineTo(x, waveY);
        }
        c.lineTo(w, h);
        c.closePath();
        c.fill();
      }
    }

    function drawIllustrationsToCtx(c, prompt, override, w, h, t) {
      const has = (kwList) => kwList.some(k => prompt.includes(k));

      // 1. City Silhouette
      if (override === 'city' || (override === 'auto' && has(['kota', 'city', 'gedung']))) {
        c.save();
        c.fillStyle = 'rgba(45, 27, 78, 0.38)';
        const buildings = [
          { x: 0.08, bw: 0.07, bh: 0.22 },
          { x: 0.16, bw: 0.09, bh: 0.30 },
          { x: 0.26, bw: 0.06, bh: 0.19 },
          { x: 0.68, bw: 0.08, bh: 0.26 },
          { x: 0.77, bw: 0.10, bh: 0.33 },
          { x: 0.88, bw: 0.07, bh: 0.21 }
        ];
        buildings.forEach((b) => {
          const bx = b.x * w;
          const bw = b.bw * w;
          const bh = b.bh * h;
          const by = h * 0.82 - bh;
          c.fillRect(bx, by, bw, bh);
          c.fillStyle = 'rgba(254, 252, 191, 0.8)';
          const winW = Math.max(3, bw * 0.12);
          const winH = Math.max(4, bh * 0.06);
          for (let wy = by + winH * 2; wy < by + bh - winH * 2; wy += winH * 2.6) {
            c.fillRect(bx + bw * 0.24, wy, winW, winH);
            c.fillRect(bx + bw * 0.62, wy, winW, winH);
          }
          c.fillStyle = 'rgba(45, 27, 78, 0.38)';
        });
        c.restore();
      }

      // 2. Cute Sitting Cat
      if (override === 'cat' || (override === 'auto' && has(['kucing', 'cat']))) {
        c.save();
        const cx = w * 0.26;
        const cy = h * 0.83;
        const s = Math.min(w, h) * 0.085;

        c.strokeStyle = '#2D3748';
        c.lineWidth = s * 0.18;
        c.lineCap = 'round';
        c.beginPath();
        c.moveTo(cx + s * 0.35, cy - s * 0.15);
        c.quadraticCurveTo(
          cx + s * 0.95 + Math.sin(t * 2.6) * (s * 0.22),
          cy - s * 0.55,
          cx + s * 0.75 + Math.sin(t * 2.6) * (s * 0.28),
          cy - s * 0.95
        );
        c.stroke();

        c.fillStyle = '#2D3748';
        c.beginPath();
        c.ellipse(cx, cy - s * 0.38, s * 0.42, s * 0.52, 0, 0, Math.PI * 2);
        c.fill();

        c.beginPath();
        c.arc(cx, cy - s * 0.95, s * 0.36, 0, Math.PI * 2);
        c.fill();

        c.beginPath();
        c.moveTo(cx - s * 0.32, cy - s * 1.12);
        c.lineTo(cx - s * 0.22, cy - s * 1.48);
        c.lineTo(cx - s * 0.04, cy - s * 1.22);
        c.closePath();
        c.fill();

        c.beginPath();
        c.moveTo(cx + s * 0.32, cy - s * 1.12);
        c.lineTo(cx + s * 0.22, cy - s * 1.48);
        c.lineTo(cx + s * 0.04, cy - s * 1.22);
        c.closePath();
        c.fill();

        const blink = Math.sin(t * 1.7) > 0.96;
        c.fillStyle = '#FDE047';
        if (!blink) {
          c.beginPath();
          c.arc(cx - s * 0.13, cy - s * 0.96, s * 0.055, 0, Math.PI * 2);
          c.arc(cx + s * 0.13, cy - s * 0.96, s * 0.055, 0, Math.PI * 2);
          c.fill();
        }
        c.restore();
      }

      // 3. Warm Coffee Cup
      if (override === 'coffee' || (override === 'auto' && has(['kopi', 'coffee', 'cangkir', 'kafe']))) {
        c.save();
        const mx = w * 0.74;
        const my = h * 0.84;
        const s = Math.min(w, h) * 0.075;

        c.strokeStyle = 'rgba(255, 255, 255, 0.8)';
        c.lineWidth = Math.max(2, s * 0.08);
        c.lineCap = 'round';
        for (let i = -1; i <= 1; i += 2) {
          c.beginPath();
          const sx = mx + i * s * 0.2;
          const phase = t * 2.2 + i;
          c.moveTo(sx, my - s * 0.85);
          c.bezierCurveTo(
            sx - s * 0.22 * Math.sin(phase), my - s * 1.25,
            sx + s * 0.22 * Math.sin(phase), my - s * 1.55,
            sx, my - s * 1.9
          );
          c.stroke();
        }

        c.strokeStyle = '#FFFDF9';
        c.lineWidth = s * 0.15;
        c.beginPath();
        c.arc(mx + s * 0.48, my - s * 0.38, s * 0.24, -Math.PI / 2, Math.PI / 2);
        c.stroke();

        c.fillStyle = '#FFFDF9';
        c.beginPath();
        c.roundRect(mx - s * 0.48, my - s * 0.75, s * 0.96, s * 0.75, [4, 4, s * 0.4, s * 0.4]);
        c.fill();

        c.fillStyle = '#FED7E2';
        c.beginPath();
        c.ellipse(mx, my + 2, s * 0.68, s * 0.12, 0, 0, Math.PI * 2);
        c.fill();
        c.restore();
      }

      // 4. Open Book
      if (override === 'book' || (override === 'auto' && has(['buku', 'book']))) {
        c.save();
        const bx = w * 0.5;
        const by = h * 0.85;
        const s = Math.min(w, h) * 0.09;
        const flutter = Math.sin(t * 3) * (s * 0.08);

        c.fillStyle = '#FFFDF9';
        c.strokeStyle = '#E9D8FD';
        c.lineWidth = Math.max(1.5, s * 0.05);

        c.beginPath();
        c.moveTo(bx, by);
        c.quadraticCurveTo(bx - s * 0.6, by - s * 0.25 - flutter, bx - s * 1.1, by - s * 0.05);
        c.lineTo(bx - s * 1.0, by + s * 0.35);
        c.quadraticCurveTo(bx - s * 0.5, by + s * 0.2, bx, by + s * 0.4);
        c.closePath();
        c.fill();
        c.stroke();

        c.beginPath();
        c.moveTo(bx, by);
        c.quadraticCurveTo(bx + s * 0.6, by - s * 0.25 + flutter, bx + s * 1.1, by - s * 0.05);
        c.lineTo(bx + s * 1.0, by + s * 0.35);
        c.quadraticCurveTo(bx + s * 0.5, by + s * 0.2, bx, by + s * 0.4);
        c.closePath();
        c.fill();
        c.stroke();
        c.restore();
      }

      // 5. Blooming Pastel Flowers
      if (override === 'flowers' || (override === 'auto' && has(['bunga', 'taman', 'mekar', 'flower']))) {
        const positions = [0.22, 0.36, 0.64, 0.78];
        positions.forEach((pxRatio, i) => {
          const fx = w * pxRatio;
          const fy = h * 0.82 - (i % 2) * (h * 0.03);
          const sway = Math.sin(t * 2 + i) * (w * 0.008);
          const r = Math.min(w, h) * 0.024;

          c.save();
          c.strokeStyle = '#68D391';
          c.lineWidth = Math.max(2, r * 0.25);
          c.beginPath();
          c.moveTo(fx, fy + r * 3.2);
          c.quadraticCurveTo(fx + sway * 0.5, fy + r * 1.6, fx + sway, fy);
          c.stroke();

          c.translate(fx + sway, fy);
          c.fillStyle = i % 2 === 0 ? '#FED7E2' : '#E9D8FD';
          for (let p = 0; p < 5; p++) {
            const ang = (p * Math.PI * 2) / 5 + t * 0.3;
            c.beginPath();
            c.arc(Math.cos(ang) * r * 0.85, Math.sin(ang) * r * 0.85, r * 0.65, 0, Math.PI * 2);
            c.fill();
          }
          c.fillStyle = '#FDE047';
          c.beginPath();
          c.arc(0, 0, r * 0.45, 0, Math.PI * 2);
          c.fill();
          c.restore();
        });
      }

      // 6. Floating Pastel Hearts
      if (override === 'hearts' || (override === 'auto' && has(['hati', 'cinta', 'love', 'bahagia']))) {
        for (let i = 0; i < 4; i++) {
          const hx = w * (0.25 + i * 0.17) + Math.sin(t * 1.5 + i) * (w * 0.015);
          const hy = h * (0.45 - ((t * 0.08 + i * 0.22) % 0.32));
          const size = Math.min(w, h) * 0.025;
          c.save();
          c.fillStyle = 'rgba(254, 215, 226, 0.9)';
          c.beginPath();
          c.moveTo(hx, hy + size * 0.3);
          c.bezierCurveTo(hx, hy, hx - size, hy, hx - size, hy + size * 0.55);
          c.bezierCurveTo(hx - size, hy + size * 1.05, hx, hy + size * 1.35, hx, hy + size * 1.6);
          c.bezierCurveTo(hx, hy + size * 1.35, hx + size, hy + size * 1.05, hx + size, hy + size * 0.55);
          c.bezierCurveTo(hx + size, hy, hx, hy, hx, hy + size * 0.3);
          c.fill();
          c.restore();
        }
      }
    }

    function drawParticlesToCtx(c, type, w, h, t) {
      if (!type || type === 'none') return;
      const scale = Math.max(0.7, Math.min(w, h) / 420);

      PARTICLE_SEEDS.forEach((p, idx) => {
        if (type === 'sakura') {
          const px = ((p.x * w + t * (28 * p.speed * scale) + Math.sin(t * 1.6 + p.phase) * 24 * scale) % (w + 40)) - 20;
          const py = ((p.y * h + t * (42 * p.speed * scale)) % (h + 40)) - 20;
          const r = (5 + p.size * 5) * scale;

          c.save();
          c.translate(px, py);
          c.rotate(t * p.rotSpeed + p.phase);
          c.scale(1, 0.65 + 0.35 * Math.sin(t * 2 + p.phase));
          c.fillStyle = idx % 2 === 0 ? 'rgba(255, 240, 245, 0.92)' : 'rgba(254, 215, 226, 0.88)';
          c.beginPath();
          c.ellipse(0, 0, r, r * 0.55, 0, 0, Math.PI * 2);
          c.fill();
          c.restore();
        } else if (type === 'fireflies') {
          const px = (p.x * w + Math.sin(t * 0.9 * p.speed + p.phase) * 35 * scale + w) % w;
          const py = (p.y * h * 0.85 + Math.cos(t * 0.8 * p.speed + p.phase) * 25 * scale + h) % h;
          const glow = 0.35 + 0.65 * Math.abs(Math.sin(t * 2.2 + p.phase));
          const rad = (3 + p.size * 4) * scale;

          c.save();
          const g = c.createRadialGradient(px, py, 0, px, py, rad * 2.4);
          g.addColorStop(0, `rgba(254, 252, 191, ${glow})`);
          g.addColorStop(1, 'rgba(254, 252, 191, 0)');
          c.fillStyle = g;
          c.beginPath();
          c.arc(px, py, rad * 2.4, 0, Math.PI * 2);
          c.fill();
          c.restore();
        } else if (type === 'rain') {
          const px = ((p.x * w - t * 65 * p.speed * scale) % w + w) % w;
          const py = ((p.y * h + t * 320 * p.speed * scale) % h);
          c.save();
          c.strokeStyle = 'rgba(190, 227, 248, 0.65)';
          c.lineWidth = 1.4 * scale;
          c.beginPath();
          c.moveTo(px, py);
          c.lineTo(px - 4 * scale, py + (14 + p.size * 6) * scale);
          c.stroke();
          c.restore();
        } else if (type === 'stars') {
          if (idx > 28) return;
          const px = p.x * w;
          const py = p.y * h * 0.65;
          const twinkle = 0.25 + 0.75 * Math.abs(Math.sin(t * 2.5 + p.phase));
          const r = (3 + p.size * 4) * scale;

          c.save();
          c.translate(px, py);
          c.fillStyle = `rgba(255, 253, 249, ${twinkle})`;
          c.beginPath();
          for (let s = 0; s < 4; s++) {
            const ang = (s * Math.PI) / 2;
            c.lineTo(Math.cos(ang) * r, Math.sin(ang) * r);
            c.lineTo(Math.cos(ang + Math.PI / 4) * (r * 0.25), Math.sin(ang + Math.PI / 4) * (r * 0.25));
          }
          c.closePath();
          c.fill();
          c.restore();
        } else if (type === 'bokeh') {
          if (idx > 22) return;
          const px = (p.x * w + Math.sin(t * 0.5 + p.phase) * 20 * scale + w) % w;
          const py = ((p.y * h - t * 22 * p.speed * scale) % h + h) % h;
          const r = (10 + p.size * 18) * scale;

          c.save();
          c.fillStyle = idx % 2 === 0 ? 'rgba(255, 255, 255, 0.24)' : 'rgba(198, 246, 213, 0.22)';
          c.beginPath();
          c.arc(px, py, r, 0, Math.PI * 2);
          c.fill();
          c.restore();
        }
      });
    }

    function renderSubtitlesToCtx(targetCtx, currentTime, w, h) {
      const seg = state.subtitle.segments.find(s => currentTime >= s.start && currentTime <= s.end);
      if (!seg || !seg.text) return;

      const subCfg = state.subtitle;
      const scaleFactor = Math.max(0.65, w / 640);
      const fontSize = Math.round(subCfg.fontSize * scaleFactor);
      const fontFamily = `"${subCfg.fontFamily}", sans-serif`;

      targetCtx.save();
      targetCtx.font = `700 ${fontSize}px ${fontFamily}`;
      targetCtx.textBaseline = 'middle';

      let baseY = state.aspectRatio === '9:16'
        ? h * 0.72
        : state.aspectRatio === '4:5'
          ? h * 0.79
          : h * 0.85;
      if (subCfg.position === 'top') baseY = state.aspectRatio === '9:16' ? h * 0.19 : h * 0.15;
      else if (subCfg.position === 'middle') baseY = h * 0.5;

      const maxLineWidth = state.aspectRatio === '9:16' ? w * 0.78 : w * 0.84;
      const words = seg.words && seg.words.length
        ? seg.words
        : seg.text.split(/\s+/).map(word => ({ word, start: seg.start, end: seg.end }));

      const lines = [];
      let currentLine = [];
      let currentLineW = 0;
      const spaceW = targetCtx.measureText(' ').width;

      words.forEach((wObj) => {
        const wWidth = targetCtx.measureText(wObj.word).width;
        if (currentLine.length > 0 && currentLineW + spaceW + wWidth > maxLineWidth) {
          lines.push(currentLine);
          currentLine = [wObj];
          currentLineW = wWidth;
        } else {
          currentLine.push(wObj);
          currentLineW += (currentLine.length > 1 ? spaceW : 0) + wWidth;
        }
      });
      if (currentLine.length > 0) lines.push(currentLine);

      const lineHeight = fontSize * 1.38;
      const totalBlockH = lines.length * lineHeight;
      const startY = baseY - totalBlockH / 2 + lineHeight / 2;

      const hexToRgba = (hex, alpha) => {
        const clean = hex.replace('#', '');
        const r = parseInt(clean.substring(0, 2), 16) || 45;
        const g = parseInt(clean.substring(2, 4), 16) || 27;
        const b = parseInt(clean.substring(4, 6), 16) || 78;
        return `rgba(${r}, ${g}, ${b}, ${alpha})`;
      };

      if (subCfg.style === 'cinema') {
        targetCtx.fillStyle = hexToRgba(subCfg.bgColor, Math.max(0.45, subCfg.bgOpacity));
        targetCtx.fillRect(0, startY - lineHeight * 0.72, w, totalBlockH + lineHeight * 0.44);
      }

      const segProgress = Math.min(1, Math.max(0, (currentTime - seg.start) / Math.max(0.1, seg.end - seg.start)));
      const totalChars = seg.text.length;
      const visibleCharLimit = subCfg.style === 'typewriter'
        ? Math.max(1, Math.ceil(totalChars * Math.min(1, segProgress * 1.25)))
        : Infinity;
      let renderedChars = 0;

      lines.forEach((lineWords, lIdx) => {
        const lineY = startY + lIdx * lineHeight;
        const lineStr = lineWords.map(lw => lw.word).join(' ');
        const lineW = targetCtx.measureText(lineStr).width;

        if (subCfg.style === 'pill-box' || subCfg.style === 'karaoke') {
          const padX = fontSize * 0.65;
          const padY = fontSize * 0.32;
          targetCtx.fillStyle = hexToRgba(subCfg.bgColor, subCfg.bgOpacity);
          targetCtx.beginPath();
          targetCtx.roundRect(w / 2 - lineW / 2 - padX, lineY - fontSize / 2 - padY, lineW + padX * 2, fontSize + padY * 2, 18 * scaleFactor);
          targetCtx.fill();
        }

        let drawX = w / 2 - lineW / 2;

        lineWords.forEach((wObj) => {
          let wordToDraw = wObj.word;
          if (subCfg.style === 'typewriter') {
            if (renderedChars >= visibleCharLimit) return;
            const remain = visibleCharLimit - renderedChars;
            wordToDraw = wObj.word.slice(0, remain);
            renderedChars += wObj.word.length + 1;
          }

          const wordW = targetCtx.measureText(wordToDraw).width;
          const isWordActive = subCfg.style === 'karaoke' && currentTime >= wObj.start && currentTime <= wObj.end + 0.12;

          if (isWordActive) {
            targetCtx.fillStyle = 'rgba(255, 255, 255, 0.24)';
            targetCtx.beginPath();
            targetCtx.roundRect(drawX - 4 * scaleFactor, lineY - fontSize * 0.56, wordW + 8 * scaleFactor, fontSize * 1.12, 8 * scaleFactor);
            targetCtx.fill();
          }

          targetCtx.shadowColor = 'rgba(20, 10, 40, 0.68)';
          targetCtx.shadowBlur = (subCfg.style === 'drop-shadow' ? 10 : 4) * scaleFactor;
          targetCtx.shadowOffsetY = 2 * scaleFactor;

          targetCtx.fillStyle = isWordActive ? subCfg.highlightColor : subCfg.textColor;
          targetCtx.fillText(wordToDraw, drawX, lineY);

          drawX += wordW + spaceW;
        });
      });

      targetCtx.restore();
    }

    function drawPlatformSafeZoneOverlay(ctx, w, h) {
      if (!state.showSafeZone) return;
      if (state.aspectRatio !== '9:16' && state.aspectRatio !== '4:5') return;

      ctx.save();
      const isVertical = state.aspectRatio === '9:16';
      const topMargin = isVertical ? h * 0.13 : h * 0.08;
      const bottomMargin = isVertical ? h * 0.22 : h * 0.14;
      const rightMargin = isVertical ? w * 0.16 : w * 0.06;
      const leftMargin = w * 0.05;

      ctx.fillStyle = 'rgba(255, 143, 177, 0.16)';
      ctx.fillRect(0, 0, w, topMargin);
      ctx.fillRect(0, h - bottomMargin, w, bottomMargin);
      if (isVertical) {
        ctx.fillRect(w - rightMargin, topMargin, rightMargin, h - topMargin - bottomMargin);
      }

      ctx.strokeStyle = 'rgba(255, 255, 255, 0.85)';
      ctx.lineWidth = 1.5;
      ctx.setLineDash([6, 4]);
      ctx.strokeRect(
        leftMargin,
        topMargin,
        w - leftMargin - rightMargin,
        h - topMargin - bottomMargin
      );
      ctx.setLineDash([]);

      if (isVertical) {
        const iconX = w - rightMargin * 0.5;
        const startIconY = h - bottomMargin - h * 0.24;
        ctx.fillStyle = 'rgba(255, 255, 255, 0.55)';
        for (let i = 0; i < 3; i++) {
          ctx.beginPath();
          ctx.arc(iconX, startIconY + i * (h * 0.075), Math.max(7, w * 0.032), 0, Math.PI * 2);
          ctx.fill();
        }
      }

      ctx.font = '700 10px "Plus Jakarta Sans", sans-serif';
      ctx.fillStyle = 'rgba(45, 27, 78, 0.78)';
      const badgeText = isVertical ? 'Zona Aman TikTok / Shorts / Reels' : 'Zona Aman IG / FB Portrait';
      const tw = ctx.measureText(badgeText).width;
      ctx.beginPath();
      ctx.roundRect(leftMargin + 6, topMargin + 6, tw + 14, 20, 10);
      ctx.fill();

      ctx.fillStyle = '#FFFFFF';
      ctx.textBaseline = 'middle';
      ctx.fillText(badgeText, leftMargin + 13, topMargin + 16);

      ctx.restore();
    }

    function renderMasterFrameAtTime(targetCtx, t, w, h) {
      targetCtx.clearRect(0, 0, w, h);
      const info = getSceneAtTime(t);
      if (!info.scene) return;

      const transDur = 0.55;
      const transType = state.transitionType;

      if (transType !== 'cut' && info.index > 0 && info.localTime < transDur) {
        const prevIdx = info.index - 1;
        const prevScene = state.scenes[prevIdx];
        const prevBounds = getSceneTimeBounds(prevIdx);
        const prevLocalTime = Math.max(0, (prevBounds.end - prevBounds.start) - (transDur - info.localTime));
        const mix = Math.min(1, Math.max(0, info.localTime / transDur));
        const ease = mix * mix * (3 - 2 * mix);

        if (transType === 'crossfade') {
          renderSceneLayerToCtx(targetCtx, prevScene, prevLocalTime, prevScene.duration, w, h, 1 - ease);
          renderSceneLayerToCtx(targetCtx, info.scene, info.localTime, info.scene.duration, w, h, ease);
        } else if (transType === 'slide-pastel') {
          renderSceneLayerToCtx(targetCtx, prevScene, prevLocalTime, prevScene.duration, w, h, 1, 1, -ease * w);
          renderSceneLayerToCtx(targetCtx, info.scene, info.localTime, info.scene.duration, w, h, 1, 1, (1 - ease) * w);
        } else if (transType === 'dreamy-zoom') {
          renderSceneLayerToCtx(targetCtx, prevScene, prevLocalTime, prevScene.duration, w, h, 1 - ease, 1 + ease * 0.15);
          renderSceneLayerToCtx(targetCtx, info.scene, info.localTime, info.scene.duration, w, h, ease, 0.92 + ease * 0.08);
        } else {
          renderSceneLayerToCtx(targetCtx, info.scene, info.localTime, info.scene.duration, w, h, 1);
        }
      } else {
        renderSceneLayerToCtx(targetCtx, info.scene, info.localTime, info.scene.duration, w, h, 1);
      }

      renderSubtitlesToCtx(targetCtx, t, w, h);
    }

    function renderPreviewFrame() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = previewCanvas.width / dpr;
      const h = previewCanvas.height / dpr;
      if (!w || !h) return;
      renderMasterFrameAtTime(previewCtx, state.playback.currentTime, w, h);
      drawPlatformSafeZoneOverlay(previewCtx, w, h);
    }

